<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>tts-speak</AssemblyName>
    <RootNamespace>CircleAI.Tools.TtsSpeak</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Drives the REAL engine, not a copy of it — the point is to prove
         OnnxTtsEngine speaks, end to end. -->
    <ProjectReference Include="..\..\src\CircleAI.Voice\CircleAI.Voice.csproj" />
  </ItemGroup>
</Project>
