<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>memory</AssemblyName>
    <RootNamespace>CircleAI.Tools.Memory</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- A shell is the one interface every model already has. Packing this as
         a dotnet tool is what lets a session on any of the three machines call
         it without knowing anything about the build. -->
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>
</Project>
