<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>memory</AssemblyName>
    <RootNamespace>CircleAI.Tools.Memory</RootNamespace>
  </PropertyGroup>

  <!-- ========== A REAL COMMAND ON ALL THREE MACHINES ==========
       A shell is the one interface every model already has, so the memory is
       only universal once "memory" is actually on PATH. A dotnet tool is the
       .NET-native way to put it there, and it is the same two lines on Linux,
       Windows and the Mac. See AGENT.md for them.
  -->
  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>memory</ToolCommandName>
    <PackageId>CircleAI.Tools.Memory</PackageId>
    <!-- No <Version> here. Directory.Build.props at the repo root is the single
         source of version truth and the whole suite moves in lockstep; the 163
         per-project versions under src/ were stripped for exactly this reason
         (060bc68). This file sits in tools/, so that sweep missed it and the
         tool shipped at 1.4.0 while everything else was 3.6.0. -->
    <Description>Universal local long-term memory: recall what this machine and the others already worked out.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>
</Project>
