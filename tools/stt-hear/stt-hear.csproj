<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>stt-hear</AssemblyName>
    <RootNamespace>CircleAI.Tools.SttHear</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Whisper.net wraps whisper.cpp AND ships its native libs per-RID via
         NuGet — the same way Microsoft.ML.OnnxRuntime ships ONNX natives. This
         is the whole point: it closes the "no whisper.dll anywhere" gap by
         construction, on Windows/Linux/Android/iOS, with no hand-built native. -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
  </ItemGroup>
</Project>
