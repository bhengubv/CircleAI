<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>stt-hear</AssemblyName>
    <RootNamespace>CircleAI.Tools.SttHear</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE PRODUCT, NOT A COPY OF IT. This tool used to carry its own WAV
         reader and call Whisper.net directly, so a pass proved that the TOOL
         could hear - which is not the claim anybody wanted. Referencing the
         shipping library means the transcriber, the file reader, the chunking
         and the subtitle writer under test here are the ones on the phone.

         Whisper.net and its per-RID natives come through CircleAI.Voice. -->
    <ProjectReference Include="..\..\src\CircleAI.Voice\CircleAI.Voice.csproj" />
  </ItemGroup>
</Project>
