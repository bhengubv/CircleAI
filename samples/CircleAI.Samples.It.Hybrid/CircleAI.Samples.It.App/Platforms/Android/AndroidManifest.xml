<?xml version="1.0" encoding="utf-8"?>
<!--
    INTERNET is declared, and declaring it is the point of this file.

    The native head shipped with no INTERNET permission at all for months and
    nobody noticed, because every model had been sideloaded over a cable. A voice
    is 60-150 MB and is downloaded on request, so without this the first "Hear it"
    fails in a way that looks like a broken server.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />
	<!--
	    RECORD_AUDIO must be in the manifest or requestPermissions is a SILENT
	    no-op and AudioRecord yields silence - which looks exactly like a wake
	    word that does not work rather than like a permission that was never
	    asked for.
	-->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<!--
	    Models are large and expensive. On a metered connection a reinstall was
	    costing about 250 MB and most of an hour, every time.
	-->
	<uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
	                 android:maxSdkVersion="29" />
	<!--
	    hasFragileUserData: on Android 10+ the uninstall dialog then OFFERS to keep
	    this app's data. One attribute, and a reinstall stops wiping the setup.

	    requestLegacyExternalStorage: API 29 honours it, which is what lets the
	    shared model folder work on the P30 this is developed against. Newer
	    devices fall back to the private directory - see ModelStore, which proves
	    the path is writable rather than assuming it.
	-->
	<application android:allowBackup="true"
	             android:supportsRtl="true"
	             android:hasFragileUserData="true"
	             android:requestLegacyExternalStorage="true"></application>
</manifest>
