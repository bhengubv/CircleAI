<?xml version="1.0" encoding="utf-8"?>
<!--
    INTERNET is declared, and declaring it is the point of this file.

    The native head shipped with no INTERNET permission at all for months and
    nobody noticed, because every model had been sideloaded over a cable. A voice
    is 60-150 MB and is downloaded on request, so without this the first "Hear it"
    fails in a way that looks like a broken server.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />
	<!--
	    RECORD_AUDIO must be in the manifest or requestPermissions is a SILENT
	    no-op and AudioRecord yields silence - which looks exactly like a wake
	    word that does not work rather than like a permission that was never
	    asked for.
	-->
	<uses-permission android:name="android.permission.RECORD_AUDIO" />
	<!--
	    THE RESIDENT SERVICE RUNS IN THE FOREGROUND, AND ON ANDROID THAT IS A
	    PERMISSION, NOT A CHOICE. Without FOREGROUND_SERVICE, startForeground
	    throws SecurityException and the platform then kills the process for not
	    having gone foreground - measured on a P30 (API 29): the wake word was
	    listening, and the app died about ten seconds later with

	        Context.startForegroundService() did not then call
	        Service.startForeground()

	    which names the symptom and not one word of the cause. This manifest had
	    only INTERNET and RECORD_AUDIO, so the service had been refused on every
	    attempt since this head existed.

	      FOREGROUND_SERVICE             API 28+. The one that was missing.
	      FOREGROUND_SERVICE_DATA_SYNC   API 34+. From 14 the TYPE needs its own
	                                     permission or the start is refused.
	      FOREGROUND_SERVICE_MICROPHONE  API 34+. Same rule for the microphone
	                                     type, which this head claims from API 30.
	      POST_NOTIFICATIONS             API 33+. A foreground service must show a
	                                     notification; denied, it still runs but
	                                     nobody can see it is holding the
	                                     microphone - which is the one thing that
	                                     notification exists to be honest about.

	    Declared unguarded, as in the native head: a build that cannot host the
	    device service is not a smaller build, it is a broken one.
	-->
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<!--
	    COMING BACK AFTER A REBOOT. Without this the assistant is silent from the
	    moment the phone restarts until somebody happens to open the app, and a
	    thing that forgets how to listen every time the battery dies is not an
	    assistant. See BootReceiver - which restores the MODELS only: from
	    Android 14 a microphone-typed foreground service may not be started from
	    BOOT_COMPLETED, so listening waits for one deliberate tap by design.
	-->
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<!--
	    hasFragileUserData: on Android 10+ the uninstall dialog OFFERS to keep this
	    app's data. One attribute, and a reinstall stops wiping 250 MB of models
	    somebody already paid for - which is the mechanism Android provides for
	    data an app NEEDS and cannot cheaply refetch. No storage permission is
	    asked for: the models are app data and stay in private storage.
	-->
	<!--
	    android:icon HAS TO BE HERE, and its absence is invisible in every build
	    log. MauiIcon generates every density - res/mipmap-*/appicon*.png and the
	    adaptive appicon.xml were all sitting in the APK - but declaring
	    <application> in this file with explicit attributes means NOTHING pointed
	    at them: `aapt2 dump badging` read back `icon=''`, so Android had no icon
	    to draw and fell back to its own generic tile. The launcher showed a white
	    jigsaw piece on a blue square, sharp-cornered next to every other app's
	    rounded icon, for as long as this line was missing.

	    The label is not the same story - that one MAUI injects from
	    ApplicationTitle, which is why the name read correctly all along and made
	    the icon look like a rendering quirk rather than a missing attribute.
	-->
	<application android:allowBackup="true"
	             android:supportsRtl="true"
	             android:icon="@mipmap/appicon"
	             android:roundIcon="@mipmap/appicon_round"
	             android:hasFragileUserData="true"></application>
</manifest>
