<!--
  The MAUI head - the app, and the only head with a splash.

  THIS IS WHERE THE SPLASH COMES FROM. <MauiSplashScreen> below is the whole
  mechanism, and it is why the native Android head has none: a splash is a MAUI
  concept, and that head is plain .NET Android with no theme declared at all, so
  Android drew its default preview window - a #FAFAFA rectangle - which flashed
  white before a #121A21 app.

  One svg feeds it, MAUI generates every density, and the Color below is the app's
  own page colour, so there is no flash and no colour jump into Home.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- iOS/MacCatalyst/Windows are deliberately not built here yet: this head is
         verified on a Huawei P30 Lite, and a target nobody has run is a claim
         rather than a platform. Adding one is a csproj line plus a Platforms
         folder, and the shared UI needs no change. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>CircleAI.Samples.It.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <ApplicationTitle>Circle AI</ApplicationTitle>
    <!-- A DIFFERENT PACKAGE ID FROM THE NATIVE HEAD. com.bhengubv.circleai is
         installed on the test phone; sharing the id would make deploying this one
         an upgrade that replaces it, and the two are meant to be comparable side
         by side. -->
    <ApplicationId>com.bhengubv.circleai.hybrid</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 24 is the floor the brand assets are checked against: strokeAlpha on a
         vector path is API 24+. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: ONE svg for the plate, one for the mark. MAUI generates every
         density, which is why this head has no mipmap folders. Both are generated
         from MarkView's geometry by tools/brand-mark/gen_mark.py. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#2196F3" />

    <!-- The splash. Color is Ui.Bg - Shade(#2c3e50, 0.42) - which a screenshot of
         the running app measures as #121A21. Matching it is the point: the splash
         is the bridge into Home, so it wears Home's background. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#121A21"
                      BaseSize="128,128" />

    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Samples.It.Shared\CircleAI.Samples.It.Shared.csproj" />

    <!-- The real voice stack. This head speaks, so it carries what speaking needs:
         the registry and selector (Core, via Hosting), the bundle downloader
         (Inference), and the ONNX engine plus phonemisers (Voice). The web heads
         reference none of this, which is exactly why the shared UI talks to
         IVoiceHost instead of to these directly. -->
    <ProjectReference Include="..\..\..\src\CircleAI.Hosting\CircleAI.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\CircleAI.Voice\CircleAI.Voice.csproj" />
    <ProjectReference Include="..\..\..\src\CircleAI.Documents\CircleAI.Documents.csproj" />
    <!-- AndroidDeviceMemory. Without it DeviceProbe reads the GC heap limit rather
         than the phone's RAM, every model fails its fit check, and the abilities
         screen reports "Needs more memory" for all of them. -->
    <ProjectReference Include="..\..\..\src\CircleAI.Device\CircleAI.Device.csproj" />
  </ItemGroup>

  <!--
    LINKED, NOT REFERENCED, and for the same reason the native head links them:
    CircleAI.Samples.It is an Exe whose Program.cs is a console entry point. Only
    the voice probe and the sample's own helpers are wanted, so they are compiled
    in directly.

    THE SET IS DELIBERATELY NARROW. The native head links the whole root glob and
    therefore references Charts, Presentations, Music, Media, BusinessOps, Cast,
    Mesh, CodeAgent and both Security libraries - everything CapabilitySweep
    touches. This head speaks and lists languages; dragging that graph into the APK
    would cost megabytes to compile code no screen here calls.

    So: the Voice folder, plus DeviceDiagnostics, which ItTtsProbe uses to report
    what the phone actually is. Adding a screen that needs more means adding the
    file and its reference deliberately, which is the point.
  -->
  <ItemGroup>
    <Compile Include="..\..\CircleAI.Samples.It\Voice\*.cs"
             Link="Shared\Voice\%(Filename)%(Extension)" />
    <Compile Include="..\..\CircleAI.Samples.It\DeviceDiagnostics.cs"
             Link="Shared\DeviceDiagnostics.cs" />
    <!-- ItSpeaker asks it which language a reply is in, to pick a voice. -->
    <Compile Include="..\..\CircleAI.Samples.It\LanguageGuess.cs"
             Link="Shared\LanguageGuess.cs" />
  </ItemGroup>

</Project>
