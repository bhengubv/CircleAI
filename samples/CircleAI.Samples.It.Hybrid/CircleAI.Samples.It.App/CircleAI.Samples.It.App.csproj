<!--
  The MAUI head - the app, and the only head with a splash.

  THIS IS WHERE THE SPLASH COMES FROM. <MauiSplashScreen> below is the whole
  mechanism, and it is why the native Android head has none: a splash is a MAUI
  concept, and that head is plain .NET Android with no theme declared at all, so
  Android drew its default preview window - a #FAFAFA rectangle - which flashed
  white before a #121A21 app.

  One svg feeds it, MAUI generates every density, and the Color below is the app's
  own page colour, so there is no flash and no colour jump into Home.
-->
<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- iOS/MacCatalyst/Windows are deliberately not built here yet: this head is
         verified on a Huawei P30 Lite, and a target nobody has run is a claim
         rather than a platform. Adding one is a csproj line plus a Platforms
         folder, and the shared UI needs no change. -->
    <OutputType>Exe</OutputType>
    <RootNamespace>CircleAI.Samples.It.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <ApplicationTitle>Circle AI</ApplicationTitle>
    <!-- A DIFFERENT PACKAGE ID FROM THE NATIVE HEAD. com.bhengubv.circleai is
         installed on the test phone; sharing the id would make deploying this one
         an upgrade that replaces it, and the two are meant to be comparable side
         by side. -->
    <ApplicationId>com.bhengubv.circleai.hybrid</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- 24 is the floor the brand assets are checked against: strokeAlpha on a
         vector path is API 24+. -->
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

    <!-- THE LINKED SOURCES ARE GUARDED BY THIS. AndroidAudio.cs is wrapped in
         #if IT_VOICE_ANDROID from end to end, so without the symbol it compiles
         to an empty file and the type simply is not there - which reads as a
         missing namespace rather than as a missing definition. This head speaks
         and listens, so the symbol is on. -->
    <DefineConstants>$(DefineConstants);IT_VOICE_ANDROID</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- App icon: ONE svg for the plate, one for the mark. MAUI generates every
         density, which is why this head has no mipmap folders. Both are generated
         from MarkView's geometry by tools/brand-mark/gen_mark.py. -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              Color="#2196F3" />

    <!-- The splash. Color is Ui.Bg - Shade(#2c3e50, 0.42) - which a screenshot of
         the running app measures as #121A21. Matching it is the point: the splash
         is the bridge into Home, so it wears Home's background. -->
    <!-- 256dp, not 128. BaseSize is the size the mark is DRAWN at, centred on the
         colour above; at 128 it was a small logo adrift in a dark screen, and on
         a 360dp phone it used barely a third of the width. 256 fills the space a
         splash is for while still clearing the narrowest handset we support. -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg"
                      Color="#121A21"
                      BaseSize="256,256" />

    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Samples.It.Shared\CircleAI.Samples.It.Shared.csproj" />

    <!-- The real voice stack. This head speaks, so it carries what speaking needs:
         the registry and selector (Core, via Hosting), the bundle downloader
         (Inference), and the ONNX engine plus phonemisers (Voice). The web heads
         reference none of this, which is exactly why the shared UI talks to
         IVoiceHost instead of to these directly. -->
    <ProjectReference Include="..\..\..\src\CircleAI.Hosting\CircleAI.Hosting.csproj" />
    <ProjectReference Include="..\..\..\src\CircleAI.Voice\CircleAI.Voice.csproj" />
    <ProjectReference Include="..\..\..\src\CircleAI.Documents\CircleAI.Documents.csproj" />
    <!-- AndroidDeviceMemory. Without it DeviceProbe reads the GC heap limit rather
         than the phone's RAM, every model fails its fit check, and the abilities
         screen reports "Needs more memory" for all of them. -->
    <ProjectReference Include="..\..\..\src\CircleAI.Device\CircleAI.Device.csproj" />
    <!-- The CV interview: its script, its profile store and the renderer. The
         screen only maps an answer onto a field - the questions and the document
         are this library's, so both apps run one interview. -->
    <ProjectReference Include="..\..\..\src\CircleAI.Career\CircleAI.Career.csproj" />
  </ItemGroup>

  <!--
    LINKED, NOT REFERENCED, and for the same reason the native head links them:
    CircleAI.Samples.It is an Exe whose Program.cs is a console entry point. Only
    the voice probe and the sample's own helpers are wanted, so they are compiled
    in directly.

    THE SET IS DELIBERATELY NARROW. The native head links the whole root glob and
    therefore references Charts, Presentations, Music, Media, BusinessOps, Cast,
    Mesh, CodeAgent and both Security libraries - everything CapabilitySweep
    touches. This head speaks and lists languages; dragging that graph into the APK
    would cost megabytes to compile code no screen here calls.

    So: the Voice folder, plus DeviceDiagnostics, which ItTtsProbe uses to report
    what the phone actually is. Adding a screen that needs more means adding the
    file and its reference deliberately, which is the point.
  -->
  <ItemGroup>
    <Compile Include="..\..\CircleAI.Samples.It\Voice\*.cs"
             Link="Shared\Voice\%(Filename)%(Extension)" />
    <Compile Include="..\..\CircleAI.Samples.It\DeviceDiagnostics.cs"
             Link="Shared\DeviceDiagnostics.cs" />
    <!-- ItSpeaker asks it which language a reply is in, to pick a voice. -->
    <Compile Include="..\..\CircleAI.Samples.It\LanguageGuess.cs"
             Link="Shared\LanguageGuess.cs" />
    <!-- The brain: the conversation session and what it needs to run a turn.
         CapabilitySweep and Program are still excluded - the sweep drags a dozen
         library references for code no screen here calls. -->
    <Compile Include="..\..\CircleAI.Samples.It\ItSession.cs" Link="Shared\ItSession.cs" />
    <Compile Include="..\..\CircleAI.Samples.It\ItGenerator.cs" Link="Shared\ItGenerator.cs" />
    <Compile Include="..\..\CircleAI.Samples.It\ItToolBridge.cs" Link="Shared\ItToolBridge.cs" />
    <Compile Include="..\..\CircleAI.Samples.It\WebSearch.cs" Link="Shared\WebSearch.cs" />
    <Compile Include="..\..\CircleAI.Samples.It\FirstRun.cs" Link="Shared\FirstRun.cs" />
  </ItemGroup>

  <!-- The microphone. Android-only by nature, and taken from the native head
       rather than rewritten: the PCM16-to-float conversion in the wake listener
       has to match what this produces, and a second copy is a second chance to
       scale the samples wrong - which made the wake word deaf for a day. -->
  <ItemGroup>
    <!-- Linked into Shared\, NOT Platforms\Android\: MAUI's single-project
         convention filters items by their Platforms path, so a file linked there
         is excluded from the build and the type simply is not there. -->
    <Compile Include="..\..\CircleAI.Samples.It.Android\AndroidAudio.cs"
             Link="Shared\AndroidAudio.cs" />
    <!-- End-of-speech detection. Its thresholds were tuned on the P30 - speech at
         3x the noise floor or an absolute 0.02, and 1.4 s of quiet to end a turn -
         and a second implementation would be a second set of numbers to get wrong
         in a way that only shows up as "it cuts me off". -->
    <Compile Include="..\..\CircleAI.Samples.It.Android\VoiceTurn.cs"
             Link="Shared\VoiceTurn.cs" />
  </ItemGroup>

  <!--
    ============================================================================
    InstallKeepingData - deploy WITHOUT throwing away the 817 MB of models.

    WHY THIS EXISTS. "dotnet build -t:Install" wipes this app's data on every
    deploy. AndroidPreserveUserData defaults to True and is passed to the
    FastDeploy task, but fast deployment is off here - EmbedAssembliesIntoApk is
    true, because that is what makes a Release build load its assemblies from
    inside the APK - so the task falls back to a plain install, which cannot
    replace an installed package and uninstalls it first. Every build log in this
    repo carries the evidence: "warning XAAADB0000: Failure
    [DELETE_FAILED_INTERNAL_ERROR]" is that uninstall being attempted.

    What gets thrown away is not a preference. Setup fetches 817 MB - two voices,
    the ears, the wake word and a 548 MB answering model - onto a phone where
    that is most of ten minutes, and it lives in app-private storage because it
    has to: this app must not assume the phone has an SD card, and a model the
    app cannot function without is not optional media. So a one-line UI change
    cost a full re-download, three times in one afternoon, and no behaviour that
    needs an installed model could be tested twice in a row.

    "adb install -r" replaces the package in place and keeps the data directory.
    It is deliberately NOT the default: -r also retains the old permission
    grants, so it is the wrong tool for verifying a first run, which is exactly
    what "-t:Install" is right for. Two targets, two jobs, and the choice is
    made on purpose rather than by whichever one somebody typed.

        dotnet build -t:InstallKeepingData -p:AdbTarget="-s SERIAL"    iterate
        dotnet build -t:Install            -p:AdbTarget="-s SERIAL"    first run
    ============================================================================
  -->
  <Target Name="InstallKeepingData" DependsOnTargets="SignAndroidPackage">
    <PropertyGroup>
      <_Adb Condition=" '$(_Adb)' == '' ">$(_AndroidPlatformToolsDirectory)adb</_Adb>
    </PropertyGroup>

    <Message Importance="high"
             Text="Installing over the existing package, keeping its data: $(ApkFileSigned)" />

    <Exec Command="&quot;$(_Adb)&quot; $(AdbTarget) install -r &quot;$(ApkFileSigned)&quot;" />

    <!-- lastUpdateTime is the only proof an install actually happened: this
         toolchain can report success without having installed anything. -->
    <Exec Command="&quot;$(_Adb)&quot; $(AdbTarget) shell dumpsys package $(_AndroidPackage) | findstr lastUpdateTime"
          ContinueOnError="true" />
  </Target>

</Project>
