<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:CircleAI.Samples.It.App"
             x:Class="CircleAI.Samples.It.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- The page colour, matching Ui.Bg on the native head and the splash
                 Color in the csproj. Declared here so the window behind the web
                 view is never a lighter shade for a frame. -->
            <Color x:Key="PageBackgroundColor">#121A21</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
