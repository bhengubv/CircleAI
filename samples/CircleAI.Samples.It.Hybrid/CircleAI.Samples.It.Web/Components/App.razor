@*
    The web head's document.

    The page background is set on the html element as well as in the stylesheet.
    The stylesheet arrives a moment after the document does, and for that moment a
    dark app renders on the browser's default white - the same white flash the
    MAUI splash exists to remove, arriving through a different door.
*@
<!DOCTYPE html>
<html lang="en" style="background:#080B0E">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#080B0E" />
    <base href="/" />
    <title>Circle AI</title>
    <!-- Before the stylesheet: sets data-theme (and repaints the html/body guard
         for a light choice) so the first frame is already the right theme. -->
    <script src="_content/CircleAI.Samples.It.Shared/theme.js"></script>
    <link rel="stylesheet" href="_content/CircleAI.Samples.It.Shared/app.css" />
    <link rel="stylesheet" href="CircleAI.Samples.It.Web.styles.css" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    <Routes @rendermode="InteractiveAuto" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
