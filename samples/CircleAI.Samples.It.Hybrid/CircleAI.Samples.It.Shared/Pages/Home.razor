@*
    Home.

    A FAITHFUL COPY OF HomeActivity.BuildUi, NOT A NEW DESIGN. Every string, size,
    colour and gap below is read off that method, and the order is the same:
    wordmark, the circle, headline, caption, progress bar, spacer, three claims,
    "Or type instead", then two quiet siblings.

    Deliberately NOT what a web page would do differently. This is one product with
    two hosts, and somebody who has used the phone app should not have to relearn
    anything. The native screen has no header bar, so this has none: the layout
    starts with the wordmark, centred, and the circle owns the upper half.
*@
@page "/home"
@inject IVoiceHost Voice
@inject ISetup Setup
@inject ISettings Settings
@inject IConversation Talk
@inject NavigationManager Nav
@inject VoiceMark Mark
@implements IDisposable

<div class="home">

    @* No wordmark here any more: the bar above carries it now that the bar is on
       every screen. The native screen prints its own because it has no bar. *@

    @*
        SLACK SPLIT ABOVE AND BELOW, not pooled underneath.

        The native screen ends with the claims, "Or type instead" and two more
        rows of links - about four rows of content holding the bottom of the
        column. Three of those moved to the bottom bar, and the single spacer
        inherited the whole difference: on a 2312px phone that left a third of the
        screen empty between the caption and the claims, with the circle stranded
        at the top. Nobody designed that gap; it is what was left over.

        A spacer at each end restores the balance the removed rows used to give,
        without moving anything the native screen still has. Weighted 1 above and
        1.4 below, so the circle sits a little above centre where it was.
    *@
    <div class="spacer spacer-top"></div>

    @* THE THING YOU PRESS, and the only large control on the screen. *@
    @* DISABLED BY THE TURN, NOT BY THIS SCREEN'S COPY OF IT. The bar's
       microphone is the same microphone, so a turn started down there has to
       close this button too - there is one of them, not one per button. *@
    <button class="hero" @onclick="Tap" disabled="@Mark.Busy"
            aria-label="@(Mark.Busy ? "Working" : "Tap to talk")">
        <BrandMark Fluid="true" State="Mark.State" Halo="true" Level="Mark.Level" Ring="true"
                   Decorative="true" />
        @* The mark is the whole of this button, and a logo is not a name.
           See .sr-only. *@
        <span class="sr-only">@(Mark.Busy ? "Working" : "Tap to talk")</span>
    </button>

    <div class="prompt">@Prompt</div>
    <div class="caption">@Caption</div>

    @* A BAR, BECAUSE THE WAIT IS NOT ONE LENGTH. Hidden unless something is
       actually downloading, so the finished screen stays as quiet as it was. *@
    @if (_progress is not null)
    {
        <div class="bar"><span></span></div>
    }

    @*
        NOT A SETTING. A READ-OUT.

        This was a picker once: one tap, eleven languages, remembered - the wrong
        shape, because a household here does not hold one language for a whole
        conversation. Every turn decides for itself and this line only reports what
        the words were. It stays empty until a turn has actually been heard, since
        announcing a language before anybody has spoken is a claim the phone has
        not earned.
    *@
    @if (_spokenIn is { Length: > 0 })
    {
        <div class="readout">Answering in @_spokenIn</div>
    }

    @* Spacer, so the claims sit low and the circle owns the upper half. *@
    <div class="spacer"></div>

    @*
        Three claims, three lines.

        The third does NOT say "nothing sent anywhere". Web search means a question
        about today's weather sends those words off the phone, and a privacy claim
        that is subtly false is worse than one that is honestly narrower.
    *@
    <div class="claims">
        @foreach (var line in Claims)
        {
            <div class="claim">@line</div>
        }
    </div>

    @*
        THE OTHER WAY IN, and the only one.

        This was removed on the way past in a commit about the services grid,
        with a note saying it had become an item on the bottom bar or a tile in
        Services. It had not. Nothing anywhere navigated to /chat afterwards,
        so the only way to say anything to this app was to speak - and somebody
        on a bus, or in a room where speaking out loud is not on, had no way in
        at all.
    *@
    @* The fallback has to lead to the SAME app the circle does. Pointing at the
       assistant while the circle opens the interpreter would make the quiet way
       in a different product from the loud one. *@
    <a class="type-link" href="@(Translating ? "translate" : "chat")">Or type instead</a>

    @* MARKETING BELONGS HERE. "What it can do" is a pitch rather than a screen
       of controls, and Home is where somebody is deciding whether to bother. *@
    <a class="pitch-link" href="abilities">What it can do</a>
</div>

@code {
    string? _progress;
    string? _detail;
    string? _spokenIn;

    /*
        THE GREETING CYCLE, deliberately not English first. The point being made is
        that this thing speaks languages other assistants do not, so the very first
        sound it makes should say so.
    */
    static readonly string[] Greetings = ["zu", "af", "st", "sw", "en"];
    int _greetIndex;
    string _greetIn => Greetings[_greetIndex];

    static string LanguageName(string tag) => SampleLanguages.Find(tag)?.Name ?? tag;

    /*
        A REAL MIC LEVEL, OR NONE - never a pretend one. It now lives on
        VoiceMark.Level rather than in a field here, because the bar's microphone
        is the same microphone.

        THIS NOTE USED TO SAY NO HEAD HAD ONE, AND THAT WAS ONLY HALF TRUE. It is
        true of IVoiceHost, which is what this screen uses to say hello: that one
        only SPEAKS, so a greeting has no level and reports none. It was never
        true of IConversation - DeviceConversation.ListenAsync subscribes to
        VoiceTurn.Level, which is real RMS off the microphone clamped to 0..1, and
        both a turn and dictation carry it. So the arcs do widen with your voice
        on the phone, and stay still on a head that only speaks.

        The rule the old note was protecting still stands: zero is the honest
        default and nothing may invent a value, because a mark that moves as
        though it were hearing you when it is not is the one lie the component's
        own notes forbid. What changed is that the listening arcs breathe on their
        own, so an absent level no longer reads as a dead button.
    */

    /// <summary>
    /// The headline. Taken from what this host can actually do rather than
    /// hard-coded to a working state - the native screen takes it from Readiness
    /// for the same reason: a screen must not claim to be usable before it is.
    /// </summary>
    /*
        THE HEADLINE COMES FROM READINESS, not from whether a voice host exists.

        That is the whole point of the Readiness type: a screen must never claim
        to be usable before it is. "Let's set it up" and "Tap and talk" are
        different promises, and guessing between them from the wrong signal is how
        a fresh install ends up inviting somebody to press a circle that cannot do
        anything yet.
    */
    Readiness _ready = new(ReadyStage.Waking, "Getting ready", "", false);

    /*
        HOME HAS TO KNOW WHICH APP THIS IS.

        Mode was a global setting that this screen did not read. Somebody could
        set the app to Interpreter, come back here, tap the circle - and get the
        assistant, because Home only ever knew one thing to do. The interpreter
        was reachable from exactly ONE place in the whole app: a link inside
        Settings > Mode worded as "Set the languages it interprets", which reads
        as configuration rather than as the way in. Four taps through a settings
        screen, and nothing on Home, in Services or on the bar said it existed.

        A mode that changes nothing on the screen it is a mode OF is not a mode.
    */
    AppMode _mode = AppMode.Assistant;
    string _pairFrom = "en";
    string _pairTo = "zu";

    /// <summary>Whether the circle should open the interpreter rather than talk.</summary>
    /// <remarks>
    /// Guarded by readiness for the same reason the headline is: with nothing
    /// installed the tap still belongs to setup, because an interpreter with no
    /// model is a screen that cannot do the thing it just offered.
    /// </remarks>
    bool Translating => _mode == AppMode.Translator
                      && _ready.Stage != ReadyStage.NeedsSetup
                      && Voice.Availability == VoiceAvailability.OnDevice;

    string Prompt => Mark.State switch
    {
        MarkState.Thinking => "Getting it ready",
        MarkState.Speaking => "Speaking",
        _ when Translating => "Tap to translate",
        _ => Voice.Availability == VoiceAvailability.OnDevice
                ? _ready.Headline
                : "Pick a language to hear",
    };

    /// <summary>
    /// In Interpreter mode the caption NAMES THE PAIR, because that is the one
    /// fact somebody needs before they put the phone down on a table between two
    /// people - and it is the fact the old flow buried behind a settings link.
    /// </summary>
    string Caption => _detail
        ?? _progress
        ?? (Translating
                ? $"{LanguageName(_pairFrom)} and {LanguageName(_pairTo)}, spoken both ways"
                : Voice.Availability == VoiceAvailability.OnDevice
                    ? _ready.Caption
                    : Voice.Provenance);

    // THE OTHER BUTTON, AND THE WAKE WORD. The circle shows a turn this screen
    // did not necessarily start, so it has to be told about one. Off the UI
    // thread - the audio loop and the wake service both report from their own.
    void OnMarkChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Mark.Changed -= OnMarkChanged;

    protected override async Task OnInitializedAsync()
    {
        Mark.Changed += OnMarkChanged;

        _ready = await Setup.ReadinessAsync();

        // Which app this is, and - if it is the interpreter - between whom.
        // Guarded: a settings read that fails must not take Home down with it.
        try
        {
            _mode = (await Settings.LoadAsync()).Mode;
            _pairFrom = await Settings.ServiceSettingAsync("interpret", "from", "en") ?? "en";
            _pairTo = await Settings.ServiceSettingAsync("interpret", "to", "zu") ?? "zu";
        }
        catch { /* stay the assistant rather than show a broken Home */ }

        // Counted, not claimed - and counted where the count is true. Guarded
        // because a host that cannot enumerate voices should print no number
        // rather than a zero.
        try { _known = (await Voice.CatalogueAsync()).Count; }
        catch { _known = 0; }
    }

    /// <summary>
    /// How many languages this phone can actually speak.
    /// </summary>
    /// <remarks>
    /// FROM THE VOICE CATALOGUE, WHICH IS THE ONLY HONEST SOURCE. "10 plus" was
    /// a hedge; replacing it with SampleLanguages.All.Count was a different wrong
    /// number - that table holds 75 NAMES, while the phone's catalogue offers 78
    /// voices, and the language screen printed both on itself, two lines apart.
    /// <para>
    /// The catalogue is per host and per device: it is the distinct languages of
    /// the TTS models this handset can actually run. A browser reports its own
    /// smaller number and is equally right about itself, which is the point of
    /// asking the host rather than a constant.
    /// </para>
    /// </remarks>
    int _known;

    string[] OnDeviceClaims =>
    [
        _known > 0 ? $"{_known} languages, spoken out loud" : "Spoken out loud, in your language",
        "Runs on the phone — works with no signal",
        "Free, no account — only searches leave the phone",
    ];

    /// <summary>The claims, and only the ones true on THIS host.</summary>
    /// <remarks>
    /// The last two are promises about where the work happens. In a browser tab
    /// they are false - the models are not there - and printing them anyway would
    /// make the shared UI lie on one of its two hosts.
    /// </remarks>
    string[] Claims => Voice.Availability == VoiceAvailability.OnDevice
        ? OnDeviceClaims
        : [OnDeviceClaims[0], "Runs on the phone — install the app to hear a voice"];

    async Task Tap()
    {
        // NOTHING INSTALLED AND NOTHING COMING. "Let's set it up. Tap to start"
        // has to actually start something; a tap that does nothing is
        // indistinguishable from broken.
        if (_ready.Stage == ReadyStage.NeedsSetup)
        {
            Nav.NavigateTo("setup");
            return;
        }

        // THE MODE DECIDES WHAT THE CIRCLE IS. Checked before anything that
        // starts a conversation, because in Interpreter mode there is no
        // conversation to start - there are two people and a table.
        if (Translating)
        {
            Nav.NavigateTo("translate");
            return;
        }

        if (Voice.Availability != VoiceAvailability.OnDevice)
        {
            // Nothing here to speak with, so go where the list is rather than doing
            // nothing: "nothing happens" is indistinguishable from "broken".
            Nav.NavigateTo("languages");
            return;
        }

        _detail = null;

        // CAN IT ACTUALLY CONVERSE? If it can, the circle does the thing the whole
        // app is for. If it cannot yet - the brain is still arriving - it says
        // hello in a catalogued language instead, because "nothing happens" is
        // indistinguishable from "broken" and hearing it speak is the fastest way
        // to understand what this is.
        var brain = await Talk.StateAsync();

        if (brain.Ready)
        {
            // THE CIRCLE OBEYS TOO. The bar and the wake word already took
            // somebody where they asked; the biggest control on the screen doing
            // something different for the same sentence is the two-owner bug this
            // app keeps producing, so both press the same router.
            using var router = new VoiceTurnRouter();

            var updates = new Progress<TurnState>(t =>
            {
                Mark.Report(t);
                router.Observe(t);
                _detail = t.Detail ?? t.Heard;
                if (t.Language is { Length: > 0 } lang) _spokenIn = LanguageName(lang);
                StateHasChanged();
            });

            try { await Talk.TurnAsync(updates, router.Token); }
            catch (Exception ex) when (router.Ended(ex)) { /* routed, not failed */ }
            catch (Exception ex) { _detail = $"{ex.GetType().Name}: {ex.Message}"; }
            finally { Mark.Clear(); }

            await router.GoAsync(Nav, line => Talk.SayAsync(line), line => { _detail = line; StateHasChanged(); });
            return;
        }

        Mark.Report(MarkState.Speaking);
        _detail = brain.Detail;

        var progress = new Progress<string>(line =>
        {
            _progress = line;
            StateHasChanged();
        });

        try
        {
            var outcome = await Voice.SpeakAsync(_greetIn, progress);
            _detail = outcome.Detail;
            // THROUGH THE CATALOGUE, one language per press. The point is that it
            // speaks languages other assistants do not, so the first sound it makes
            // should not always be English.
            _greetIndex = (_greetIndex + 1) % Greetings.Length;
        }
        catch (Exception ex)
        {
            _detail = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _progress = null;
            Mark.Clear();
        }
    }

    /// <summary>
    /// The typing screen. The native "Or type instead" opens MainActivity, which
    /// is the conversation - not the language list.
    /// </summary>
}
