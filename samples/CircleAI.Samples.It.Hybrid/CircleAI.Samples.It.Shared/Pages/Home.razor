@*
    Home.

    A FAITHFUL COPY OF HomeActivity.BuildUi, NOT A NEW DESIGN. Every string, size,
    colour and gap below is read off that method, and the order is the same:
    wordmark, the circle, headline, caption, progress bar, spacer, three claims,
    "Or type instead", then two quiet siblings.

    Deliberately NOT what a web page would do differently. This is one product with
    two hosts, and somebody who has used the phone app should not have to relearn
    anything. The native screen has no header bar, so this has none: the layout
    starts with the wordmark, centred, and the circle owns the upper half.
*@
@page "/"
@inject IVoiceHost Voice
@inject ISetup Setup
@inject IConversation Talk
@inject NavigationManager Nav

<div class="home">

    @* No wordmark here any more: the bar above carries it now that the bar is on
       every screen. The native screen prints its own because it has no bar. *@

    @* THE THING YOU PRESS, and the only large control on the screen. *@
    <button class="hero" @onclick="Tap" disabled="@(_state != MarkState.Idle)"
            aria-label="@(_state == MarkState.Idle ? "Tap to talk" : "Working")">
        <BrandMark Fluid="true" State="_state" Halo="true" Level="_level" />
    </button>

    <div class="prompt">@Prompt</div>
    <div class="caption">@Caption</div>

    @* A BAR, BECAUSE THE WAIT IS NOT ONE LENGTH. Hidden unless something is
       actually downloading, so the finished screen stays as quiet as it was. *@
    @if (_progress is not null)
    {
        <div class="bar"><span></span></div>
    }

    @*
        NOT A SETTING. A READ-OUT.

        This was a picker once: one tap, eleven languages, remembered - the wrong
        shape, because a household here does not hold one language for a whole
        conversation. Every turn decides for itself and this line only reports what
        the words were. It stays empty until a turn has actually been heard, since
        announcing a language before anybody has spoken is a claim the phone has
        not earned.
    *@
    @if (_spokenIn is { Length: > 0 })
    {
        <div class="readout">Answering in @_spokenIn</div>
    }

    @* Spacer, so the claims sit low and the circle owns the upper half. *@
    <div class="spacer"></div>

    @*
        Three claims, three lines.

        The third does NOT say "nothing sent anywhere". Web search means a question
        about today's weather sends those words off the phone, and a privacy claim
        that is subtly false is worse than one that is honestly narrower.
    *@
    <div class="claims">
        @foreach (var line in Claims)
        {
            <div class="claim">@line</div>
        }
    </div>

    @*
        NO LINKS HERE ANY MORE. "Or type instead", "10 plus languages" and "What it
        can do" all became items on the bottom bar or tiles in Services, and a
        screen that offers the same three destinations twice is a screen arguing
        with its own navigation. Home is the circle, what it is doing, and what it
        promises.
    *@
</div>

@code {
    MarkState _state = MarkState.Idle;
    string? _progress;
    string? _detail;
    string? _spokenIn;
    double _level;

    /*
        THE GREETING CYCLE, deliberately not English first. The point being made is
        that this thing speaks languages other assistants do not, so the very first
        sound it makes should say so.
    */
    static readonly string[] Greetings = ["zu", "af", "st", "sw", "en"];
    int _greetIndex;
    string _greetIn => Greetings[_greetIndex];

    static string LanguageName(string tag) => SampleLanguages.Find(tag)?.Name ?? tag;

    /*
        NO MIC LEVEL, AND NO PRETEND ONE. BrandMark can scale its arcs with a real
        microphone level and the native mark feeds it one, but IVoiceHost only
        speaks - it does not listen - so no head here has a level to report. A
        fabricated value would animate the mark as though it were hearing you,
        which is the one lie the component's own notes forbid.
    */

    /// <summary>
    /// The headline. Taken from what this host can actually do rather than
    /// hard-coded to a working state - the native screen takes it from Readiness
    /// for the same reason: a screen must not claim to be usable before it is.
    /// </summary>
    /*
        THE HEADLINE COMES FROM READINESS, not from whether a voice host exists.

        That is the whole point of the Readiness type: a screen must never claim
        to be usable before it is. "Let's set it up" and "Tap and talk" are
        different promises, and guessing between them from the wrong signal is how
        a fresh install ends up inviting somebody to press a circle that cannot do
        anything yet.
    */
    Readiness _ready = new(ReadyStage.Waking, "Getting ready", "", false);

    string Prompt => _state switch
    {
        MarkState.Thinking => "Getting it ready",
        MarkState.Speaking => "Speaking",
        _ => Voice.Availability == VoiceAvailability.OnDevice
                ? _ready.Headline
                : "Pick a language to hear",
    };

    string Caption => _detail
        ?? _progress
        ?? (Voice.Availability == VoiceAvailability.OnDevice
                ? _ready.Caption
                : Voice.Provenance);

    protected override async Task OnInitializedAsync()
        => _ready = await Setup.ReadinessAsync();

    static readonly string[] OnDeviceClaims =
    [
        "10 plus languages, spoken out loud",
        "Runs on the phone — works with no signal",
        "Free, no account — only searches leave the phone",
    ];

    /// <summary>The claims, and only the ones true on THIS host.</summary>
    /// <remarks>
    /// The last two are promises about where the work happens. In a browser tab
    /// they are false - the models are not there - and printing them anyway would
    /// make the shared UI lie on one of its two hosts.
    /// </remarks>
    string[] Claims => Voice.Availability == VoiceAvailability.OnDevice
        ? OnDeviceClaims
        : [OnDeviceClaims[0], "Runs on the phone — install the app to hear a voice"];

    async Task Tap()
    {
        // NOTHING INSTALLED AND NOTHING COMING. "Let's set it up. Tap to start"
        // has to actually start something; a tap that does nothing is
        // indistinguishable from broken.
        if (_ready.Stage == ReadyStage.NeedsSetup)
        {
            Nav.NavigateTo("setup");
            return;
        }

        if (Voice.Availability != VoiceAvailability.OnDevice)
        {
            // Nothing here to speak with, so go where the list is rather than doing
            // nothing: "nothing happens" is indistinguishable from "broken".
            Nav.NavigateTo("languages");
            return;
        }

        _detail = null;

        // CAN IT ACTUALLY CONVERSE? If it can, the circle does the thing the whole
        // app is for. If it cannot yet - the brain is still arriving - it says
        // hello in a catalogued language instead, because "nothing happens" is
        // indistinguishable from "broken" and hearing it speak is the fastest way
        // to understand what this is.
        var brain = await Talk.StateAsync();

        if (brain.Ready)
        {
            var updates = new Progress<TurnState>(t =>
            {
                _state = t.Phase switch
                {
                    TurnPhase.Listening => MarkState.Listening,
                    TurnPhase.Thinking => MarkState.Thinking,
                    TurnPhase.Speaking => MarkState.Speaking,
                    _ => MarkState.Idle,
                };
                _level = t.Level;
                _detail = t.Detail ?? t.Heard;
                if (t.Language is { Length: > 0 } lang) _spokenIn = LanguageName(lang);
                StateHasChanged();
            });

            try { await Talk.TurnAsync(updates); }
            catch (Exception ex) { _detail = $"{ex.GetType().Name}: {ex.Message}"; }
            finally { _state = MarkState.Idle; _level = 0; }
            return;
        }

        _state = MarkState.Speaking;
        _detail = brain.Detail;

        var progress = new Progress<string>(line =>
        {
            _progress = line;
            StateHasChanged();
        });

        try
        {
            var outcome = await Voice.SpeakAsync(_greetIn, progress);
            _detail = outcome.Detail;
            // THROUGH THE CATALOGUE, one language per press. The point is that it
            // speaks languages other assistants do not, so the first sound it makes
            // should not always be English.
            _greetIndex = (_greetIndex + 1) % Greetings.Length;
        }
        catch (Exception ex)
        {
            _detail = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _progress = null;
            _state = MarkState.Idle;
        }
    }

    /// <summary>
    /// The typing screen. The native "Or type instead" opens MainActivity, which
    /// is the conversation - not the language list.
    /// </summary>
    void Type() => Nav.NavigateTo("chat");
}
