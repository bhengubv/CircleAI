@*
    Pick a language.

    A FAITHFUL COPY OF LanguagePickerActivity, not a new screen. Header block on
    Ui.Surface, then cards: bold English name, a quiet line of endonym and download
    size, and "Hear it" on the right. Same strings, same order, same weights.
*@
@page "/languages"
@inject IVoiceHost Voice

<div class="head">
    <div class="title">Pick a language</div>
    <div class="status">@Status</div>

    @* Search sits inside the header block, below the status, top margin 14. *@
    <input class="search" type="search" placeholder="Search 10 plus languages"
           aria-label="Search languages"
           value="@_query" @oninput="OnQuery" />
</div>

<div class="list">
    @foreach (var lang in Shown)
    {
        @* Keyed on the tag so filtering reuses rows rather than rebuilding 75. *@
        <div class="card" @key="lang.Tag">
            <div class="card-text">
                <div class="card-title">@lang.Name</div>
                @*
                    THE LINE IS PINNED LEFT-TO-RIGHT, the endonym is not.

                    A line takes its direction from its first strong character, so
                    the Arabic, Persian and Urdu rows rendered as "MB 114 · العربية"
                    - the language's own name shown wrongly, on the screen meant to
                    show it respect. dir="ltr" pins the line; the isolated span lets
                    the name render right-to-left inside it, which is correct.
                *@
                <div class="card-sub" dir="ltr">
                    <span class="endonym" dir="auto">@lang.Native</span>
                    @if (SubFor(lang) is { Length: > 0 } sub)
                    {
                        <span class="dot">·</span><span class="size">@sub</span>
                    }
                </div>
            </div>

            @* WORDS, NOT A GLYPH. A bare speaker icon is a guess for anyone who has
               not met one, and this screen is read by people meeting the product
               for the first time. *@
            <div class="hear" role="button" tabindex="0"
                 @onclick="() => Speak(lang)">Hear it</div>
        </div>
    }
</div>

@code {
    /// <summary>A row as the screen shows it: the head's tag, named by the table.</summary>
    /// <remarks>
    /// Display() in the native screen returns (tag, tag, null) for a tag the name
    /// table has no row for, so such a language appears as its bare code. Copied
    /// rather than filtered out: the list must be the same list on both apps, and
    /// a language quietly missing from one is exactly the failure that made a
    /// Korean row read "ko".
    /// </remarks>
    sealed record Row(string Tag, string Name, string Native, string? Greeting, long? Bytes);

    string _query = "";
    string? _busy;
    readonly Dictionary<string, string> _detail = new();

    List<Row> _all = [];
    List<Row> Shown = [];

    string Status => _loading
        ? "Loading…"
        : _query.Length == 0
            ? $"{_all.Count} languages · {Where}"
            : $"{Shown.Count} of {_all.Count} match “{_query}”";

    bool _loading = true;

    string Where => Voice.Availability == VoiceAvailability.OnDevice
        ? "runs on this phone · nothing leaves the device"
        : "voices run on the phone app";

    protected override async Task OnInitializedAsync()
    {
        var catalogue = await Voice.CatalogueAsync();
        _all = catalogue
            .Select(v =>
            {
                var named = SampleLanguages.Find(v.Tag);
                return new Row(v.Tag,
                               named?.Name ?? v.Tag,
                               named?.Native ?? v.Tag,
                               named?.Greeting,
                               v.Bytes);
            })
            .OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
            .ToList();
        _loading = false;
        Filter();
    }

    void OnQuery(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        Filter();
    }

    void Filter()
    {
        var q = _query.Trim();
        Shown = q.Length == 0
            ? _all.ToList()
            : _all.Where(l =>
                    l.Name.Contains(q, StringComparison.OrdinalIgnoreCase)
                 || l.Native.Contains(q, StringComparison.OrdinalIgnoreCase)
                 || l.Tag.StartsWith(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    /// <summary>
    /// The quiet second line - "isiZulu  ·  114 MB" - or whatever progress is
    /// currently being reported for this row.
    /// </summary>
    /// <remarks>
    /// The native screen writes progress INTO this line and restores the subtitle
    /// afterwards rather than adding a row underneath, so the list does not reflow
    /// while somebody is reading it. Same here.
    /// </remarks>
    string SubFor(Row row)
        => _detail.TryGetValue(row.Tag, out var line)
            ? line
            : row.Bytes is long b ? $"{b / 1_000_000} MB" : "";

    async Task Speak(Row row)
    {
        // One at a time. Tapping a second language mid-download left two
        // synthesisers racing for the speaker on the native screen.
        if (_busy is not null) return;

        _busy = row.Tag;
        _detail[row.Tag] = "preparing…";

        var progress = new Progress<string>(line =>
        {
            _detail[row.Tag] = line;
            StateHasChanged();
        });

        try
        {
            var outcome = await Voice.SpeakAsync(row.Tag, progress);
            _detail[row.Tag] = outcome.Detail;
        }
        catch (Exception ex)
        {
            _detail[row.Tag] = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _busy = null;
        }
    }
}
