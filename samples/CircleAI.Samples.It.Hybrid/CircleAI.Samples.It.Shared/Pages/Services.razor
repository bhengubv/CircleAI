@*
    Services - everything the app can do.

    COLLAPSIBLE PANELS, so all of it is on one screen. Every group is visible at
    once with its count, which is what answers the question this screen exists for:
    how does anybody find out what the thing does. Opening one shows its tiles.

    The version before this was chips - one group's tiles at a time - and it showed
    five of fifty-eight. It answered "nothing scrolls" and broke the thing that
    matters, which is that the breadth is VISIBLE. Nine headings and a count each
    show the whole shape of the app in one look.

    A tile opens the conversation pointed at the thing rather than going to a
    screen. That is what makes breadth free: fifty-eight tiles need fifty-eight
    first sentences, not fifty-eight screens - and it is how an assistant works,
    since you ask it rather than navigate to it.
*@
@page "/services"
@inject NavigationManager Nav

<div class="services">

    <div class="intro">@Total things it can help you with</div>

    @for (var i = 0; i < Capabilities.All.Count; i++)
    {
        var index = i;
        var group = Capabilities.All[i];
        var open = _open == i;

        <div class="panel @(open ? "panel-open" : null)">
            <button class="panel-head" @onclick="() => Toggle(index)"
                    aria-expanded="@open">
                <span class="panel-title">@group.Title</span>
                <span class="panel-count">@group.Items.Length</span>
                <span class="panel-chevron" aria-hidden="true">›</span>
            </button>

            @if (open)
            {
                <div class="grid">
                    @foreach (var c in group.Items)
                    {
                        <button class="tile" @onclick="() => Open(c)">
                            <span class="tile-icon" aria-hidden="true">@c.Icon</span>
                            <span class="tile-label">@c.Title</span>
                        </button>
                    }
                </div>
            }
        </div>
    }

</div>

@code {
    /// <summary>
    /// Which panel is open, or -1 for none.
    /// </summary>
    /// <remarks>
    /// ONE AT A TIME. With several open the headings below the fold stop being
    /// visible, which is the whole reason this screen changed shape - the point is
    /// that somebody can SEE all nine without moving.
    /// </remarks>
    int _open = -1;

    static int Total => Capabilities.All.Sum(g => g.Items.Length);

    void Toggle(int index) => _open = _open == index ? -1 : index;

    /// <summary>
    /// Open a capability: its own screen where one genuinely exists, otherwise the
    /// conversation with the first sentence already written.
    /// </summary>
    /// <remarks>
    /// MOST HAVE NO SCREEN AND SHOULD NOT. Fifty-eight screens is how an assistant
    /// becomes a menu system. The few that go somewhere - the CV, the language
    /// list, interpreting - are a form or a list rather than a question.
    /// <para>
    /// The opener lands in the box rather than being sent, so somebody nudged into
    /// a subject can change it first.
    /// </para>
    /// </remarks>
    void Open(Capability c)
        => Nav.NavigateTo(c.Route ?? $"chat?ask={Uri.EscapeDataString(c.Opener)}");
}
