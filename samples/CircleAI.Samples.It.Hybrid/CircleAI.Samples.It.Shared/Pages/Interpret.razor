@*
    Interpreting - standing between two people who do not share a language.

    ITS OWN LANGUAGES, ITS OWN SCREEN. The pair belongs to this service, not to
    the app: somebody can run the app in English, keep their CV in Japanese, and
    interpret between Korean and Mandarin. A single global "language" forces all
    three to agree, which is wrong for everybody who needs more than one.

    TWO DIRECTIONS, ONE TAP. A conversation between two people changes direction
    every few seconds, and asking somebody to re-pick "from" and "to" each time
    makes the phone the slowest person in the room.

    NOTHING SCROLLS: two pickers, a box, two buttons, and the answer.
*@
@page "/interpret"
@inject ISettings Settings
@inject IBrain Brain
@inject IConversation Talk
@inject IFormFactor Host
@inject NavigationManager Nav

<div class="interpret">

    <div class="pair">
        <label class="side">
            <span class="side-label">From</span>
            @* @bind:get/@bind:set, not value= with @onchange: a re-applied value
               attribute is what made the settings picker snap back to its old
               choice while the new one was still being saved. *@
            <select class="select" @bind:get="_from" @bind:set="SetFrom">
                @foreach (var l in Languages)
                {
                    <option value="@l.Tag">@l.Name</option>
                }
            </select>
        </label>

        <button class="swap" @onclick="Swap" aria-label="Swap the languages">&#8646;</button>

        <label class="side">
            <span class="side-label">To</span>
            <select class="select" @bind:get="_to" @bind:set="SetTo">
                @foreach (var l in Languages)
                {
                    <option value="@l.Tag">@l.Name</option>
                }
            </select>
        </label>
    </div>

    @* Same as the CV answer box: a controlled value re-applied per keystroke
       drops characters, and here it would be words put into somebody else's
       mouth. *@
    <textarea class="say" rows="3" placeholder="Type what they said"
              aria-label="What to interpret"
              @bind="_input" @bind:event="oninput"></textarea>

    @*
        A WAY IN THAT IS NOT THE KEYBOARD.

        This screen argues in its own opening that a conversation changes
        direction every few seconds and that making somebody re-pick each time
        "makes the phone the slowest person in the room" - and then offered a
        keyboard as the only input. Typing out what the person in front of you
        just said IS the phone being the slowest thing in the room, and it asks
        the one thing this app exists to stop assuming: that they can type.
    *@
    <div class="actions">
        @if (Host.IsOnDevice)
        {
            <button class="soft" @onclick="Hear" disabled="@_busy">Say it</button>
        }
        <button class="soft" @onclick="Speak" disabled="@_busy">Read it out</button>
        <button class="primary" @onclick="Run" disabled="@(_busy || _input.Trim().Length == 0)">Interpret</button>
    </div>

    @if (_out.Length > 0)
    {
        <div class="out" dir="auto">@_out</div>
    }

    @if (_note is not null)
    {
        <p class="note">@_note</p>

        @* The instruction, pressable - the same fix the chat screen offers, and
           only where pressing it does something. *@
        @if (Host.IsOnDevice && _note.Contains("Settings", StringComparison.Ordinal))
        {
            <button class="soft" @onclick='() => Nav.NavigateTo("settings")'>Turn it on</button>
        }
    }

</div>

@code {
    const string Service = "interpret";

    static IReadOnlyList<SampleLanguage> Languages { get; } = SampleLanguages.All.Values
        .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    string _from = "en";
    string _to = "zu";
    string _input = "";
    string _out = "";
    string? _note;
    bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _from = await Settings.ServiceSettingAsync(Service, "from", "en") ?? "en";
        _to = await Settings.ServiceSettingAsync(Service, "to", "zu") ?? "zu";
    }

    async Task SetFrom(string tag)
    {
        _from = tag;
        await Settings.SetServiceSettingAsync(Service, "from", tag);
    }

    async Task SetTo(string tag)
    {
        _to = tag;
        await Settings.SetServiceSettingAsync(Service, "to", tag);
    }

    /// <summary>Turn the pair around.</summary>
    /// <remarks>
    /// A conversation changes direction every few seconds. Without this the phone
    /// is the slowest person in the room.
    /// </remarks>
    async Task Swap()
    {
        (_from, _to) = (_to, _from);
        await Settings.SetServiceSettingAsync(Service, "from", _from);
        await Settings.SetServiceSettingAsync(Service, "to", _to);
    }

    /// <summary>Take what the other person said, without typing it.</summary>
    /// <remarks>
    /// DICTATION, NOT A TURN: it writes down what was heard and stops. A
    /// conversational turn would answer them.
    /// </remarks>
    async Task Hear()
    {
        if (_busy) return;
        _busy = true;
        _note = null;

        var updates = new Progress<TurnState>(t =>
        {
            if (t.Heard is { Length: > 0 } heard) _input = heard;
            if (t.Detail is { Length: > 0 } detail) _note = detail;
            InvokeAsync(StateHasChanged);
        });

        try { await Talk.DictateAsync(updates); }
        catch (Exception ex) { _note = Plain(ex); }
        finally { _busy = false; }
    }

    async Task Run()
    {
        if (_busy || _input.Trim().Length == 0) return;
        _busy = true;
        _note = null;

        // WHAT IS MISSING, NOT AN EXCEPTION TYPE. Without the answering model
        // this threw and printed something like "InvalidOperationException" at
        // somebody standing in front of a nurse. It is the same fact the chat
        // screen states plainly, and the same button that fixes it.
        var brain = await Brain.StateAsync();
        if (!brain.Ready)
        {
            _note = brain.Detail;
            _busy = false;
            return;
        }

        var fromName = SampleLanguages.Find(_from)?.Name ?? _from;
        var toName = SampleLanguages.Find(_to)?.Name ?? _to;

        try
        {
            // ASKED AS A TRANSLATION, NOT AS A CONVERSATION. Without "give only the
            // translation" the model answers the sentence rather than rendering it,
            // which is a different and much worse thing to hand somebody standing
            // in front of a nurse.
            _out = await Brain.AskAsync(
                $"Translate this from {fromName} to {toName}. "
              + $"Give only the translation, nothing else:\n\n{_input.Trim()}");
        }
        catch (Exception ex)
        {
            _note = Plain(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// A failure said in words, not in the name of a .NET type.
    /// </summary>
    /// <remarks>
    /// "InvalidOperationException: Sequence contains no elements" is a sentence
    /// for whoever wrote this, handed to somebody interpreting for a nurse. The
    /// type name goes where it belongs - the trace - and the person gets
    /// something they can act on.
    /// </remarks>
    static string Plain(Exception ex) => ex switch
    {
        HttpRequestException => "Could not reach the internet.",
        IOException => "Not enough space on the phone.",
        _ => "That did not work. Try again, or type it instead.",
    };

    /// <summary>Read the translation out, in the language it is written in.</summary>
    /// <remarks>
    /// The point of interpreting on a phone is that the other person HEARS it.
    /// Handing them a screen to read assumes they can, which is the assumption
    /// this app exists to stop making.
    /// </remarks>
    async Task Speak()
    {
        if (_out.Length == 0) { _note = "Interpret something first."; return; }
        _busy = true;
        try { await Talk.SayAsync(_out, _to); }
        catch (Exception ex) { _note = Plain(ex); }
        finally { _busy = false; }
    }
}
