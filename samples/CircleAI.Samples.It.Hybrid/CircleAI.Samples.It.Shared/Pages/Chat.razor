@*
    Ask CircleAI.

    A COPY OF MainActivity + ChatView: a quiet status line, the turns as bubbles -
    yours solid blue on the right, its bordered surface on the left - and a
    composer pinned to the bottom.

    THE BORDER ON THE REPLY MATTERS. On a dark background an unbordered card and
    the page behind it are the same colour at a glance, and the reply stops looking
    like a distinct thing.
*@
@page "/chat"
@inject IBrain Brain
@inject IConversation Talk
@inject NavigationManager Nav

<div class="chat">
    @if (_status.Length > 0)
    {
        @* Centred and quiet, so it reads as the app speaking about itself rather
           than as a turn in the conversation. *@
        <div class="status">@_status</div>
    }

    <div class="turns">
        @if (_turns.Count == 0 && _status.Length == 0)
        {
            <div class="welcome">Ask it something.</div>
        }

        @foreach (var (turn, i) in _turns.Select((t, i) => (t, i)))
        {
            <div class="row @(turn.Mine ? "row-mine" : "row-its")" @key="i">
                <div class="bubble @(turn.Mine ? "mine" : "its")">@turn.Text</div>
            </div>
        }
    </div>

    @*
        THE PROBE ROW, on its own line above the input.

        A phone fits about four buttons per row; keeping these here and Send below
        means neither line ever overflows. Every one of them used to be an in-house
        word - Sweep, Caps, Vision, TTS - that nobody outside the project could
        guess at. They say what happens when you press them.
    *@
    <div class="probes">
        <button class="probe" @onclick='() => Nav.NavigateTo("abilities")'>What it can do</button>
        <label class="probe">
            Read an image
            <InputFile OnChange="OnImage" accept="image/*" hidden />
        </label>
        <button class="probe" @onclick="Speak" disabled="@(_busy || LastReply is null)">
            Read it out
        </button>
    </div>

    @* THE headline feature, so it gets a row to itself rather than a third of one.
       Sharing the row wrapped the word to "Languag / es". *@
    <button class="hero-btn" @onclick='() => Nav.NavigateTo("languages")'>
        Speak in 10 plus languages
    </button>

    <div class="composer">
        <input class="input" placeholder="Type a message"
               aria-label="Your message"
               disabled="@(!_ready)"
               value="@_draft"
               @oninput="e => _draft = e.Value?.ToString() ?? string.Empty"
               @onkeydown="OnKey" />
        @* Use the mic: one spoken turn, heard and answered out loud. *@
        <button class="mic" @onclick="Listen" disabled="@(!_ready || _busy)"
                aria-label="Use the mic">🎙</button>
        <button class="send" @onclick="Send" disabled="@(!_ready || _busy)">Send</button>
    </div>
</div>

@code {
    readonly List<Utterance> _turns = [];
    string _draft = "";
    string _status = "Getting ready…";
    bool _ready;
    bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var state = await Brain.StateAsync();
        _ready = state.Ready;

        // A TILE ARRIVES AS A QUESTION, not as a category. The grid's whole point
        // is getting somebody past the blank page, so the opener is put in the box
        // rather than sent - they can edit it, which somebody nudged into a
        // subject usually wants to.
        //
        // Parsed by hand rather than with QueryHelpers: that lives in
        // Microsoft.AspNetCore.WebUtilities, which this Razor library does not
        // reference, and one query parameter is not worth a package.
        var q = new Uri(Nav.Uri).Query;
        const string key = "ask=";
        var at = q.IndexOf(key, StringComparison.Ordinal);
        if (at >= 0)
        {
            var value = q[(at + key.Length)..];
            var amp = value.IndexOf('&');
            if (amp >= 0) value = value[..amp];
            _draft = Uri.UnescapeDataString(value);
        }

        // The reason, not "unavailable": "Answering needs a 548 MB model" tells
        // somebody what to do next.
        _status = state.Ready ? "" : state.Detail;
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Send();
    }

    async Task Send()
    {
        var text = _draft.Trim();
        if (text.Length == 0 || _busy || !_ready) return;

        _turns.Add(new Utterance(true, text));
        _draft = "";
        _busy = true;

        // The open reply, appended to as fragments arrive.
        var reply = new Utterance(false, "");
        _turns.Add(reply);
        var at = _turns.Count - 1;

        try
        {
            await Brain.AskAsync(text, fragment =>
            {
                _turns[at] = _turns[at] with { Text = Strip(_turns[at].Text + fragment) };
                InvokeAsync(StateHasChanged);
            });
        }
        catch (Exception ex)
        {
            _turns[at] = _turns[at] with { Text = $"{ex.GetType().Name}: {ex.Message}" };
        }
        finally
        {
            // AN EMPTY BUBBLE MEANS THE MODEL PRODUCED NOTHING. Leaving it is a
            // grey rectangle with no explanation, which reads as a bug rather
            // than as silence.
            if (string.IsNullOrWhiteSpace(_turns[at].Text)) _turns.RemoveAt(at);
            _busy = false;
        }
    }

    string? LastReply => _turns.LastOrDefault(t => !t.Mine)?.Text;

    /// <summary>Speak the last answer aloud.</summary>
    /// <remarks>
    /// The app is a VOICE assistant, and a chat screen that can only be read is
    /// the demo rather than the product - especially for somebody who cannot read
    /// comfortably, who is a large part of who this is for.
    /// </remarks>
    async Task Speak()
    {
        if (LastReply is not { Length: > 0 } text) return;
        _busy = true;
        try { await Talk.SayAsync(text); }
        catch (Exception ex) { _status = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _busy = false; }
    }

    /// <summary>One spoken turn: listen, answer, say it back.</summary>
    async Task Listen()
    {
        if (_busy) return;
        _busy = true;

        var updates = new Progress<TurnState>(t =>
        {
            _status = t.Phase switch
            {
                TurnPhase.Listening => "Listening…",
                TurnPhase.Thinking => "Working on it…",
                TurnPhase.Speaking => "Answering…",
                _ => t.Detail ?? "",
            };

            // The heard question and the reply become turns as soon as they exist,
            // so the conversation reads the same whether it was typed or spoken.
            if (t.Heard is { Length: > 0 } heard
                && _turns.LastOrDefault(x => x.Mine)?.Text != heard)
                _turns.Add(new Utterance(true, heard));

            if (t.Reply is { Length: > 0 } reply)
            {
                if (_turns.Count > 0 && !_turns[^1].Mine) _turns[^1] = new Utterance(false, reply);
                else _turns.Add(new Utterance(false, reply));
            }

            InvokeAsync(StateHasChanged);
        });

        try { await Talk.TurnAsync(updates); }
        catch (Exception ex) { _status = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _busy = false; }
    }

    /// <summary>Answer a question about a picture.</summary>
    async Task OnImage(InputFileChangeEventArgs e)
    {
        if (_busy) return;
        _busy = true;
        _status = "Looking at it…";

        try
        {
            // Capped: a modern phone camera produces files a vision model has no
            // use for at full size, and reading one into memory on a P30 is how a
            // screen dies rather than answers.
            await using var stream = e.File.OpenReadStream(8 * 1024 * 1024);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _turns.Add(new Utterance(true, $"What is in this picture? ({e.File.Name})"));
            var reply = new Utterance(false, "");
            _turns.Add(reply);
            var at = _turns.Count - 1;

            await Brain.SeeAsync("What is in this picture?", buffer.ToArray(), fragment =>
            {
                _turns[at] = _turns[at] with { Text = _turns[at].Text + fragment };
                InvokeAsync(StateHasChanged);
            });

            if (string.IsNullOrWhiteSpace(_turns[at].Text)) _turns.RemoveAt(at);
        }
        catch (Exception ex)
        {
            _status = $"{ex.GetType().Name}: {ex.Message}";
        }
        finally
        {
            _status = "";
            _busy = false;
        }
    }

    /// <summary>
    /// Removes the routing marker the session streams in front of its answers.
    /// </summary>
    /// <remarks>
    /// The session prefixes replies with something like "IT! &gt; ", which made
    /// sense when every turn was a line in one text buffer and you needed to know
    /// who was talking. A bubble already says that by its side and its colour, so
    /// the prefix is the old interface leaking into the new one - and left alone,
    /// the first thing the assistant appears to say is its own name and a piece of
    /// punctuation.
    /// <para>
    /// Chunks arrive a few characters at a time, so the marker can be split across
    /// several. Re-checked while the text is still short rather than tried once.
    /// </para>
    /// </remarks>
    static string Strip(string text)
    {
        if (text.Length > 24) return text;
        var cut = text.IndexOf('>');
        return cut >= 0 && cut <= 12 && text[..cut].Trim().Length <= 10
            ? text[(cut + 1)..].TrimStart()
            : text;
    }
}
