<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CircleAI.Samples.Harness</RootNamespace>
    <AssemblyName>circleai-harness-sample</AssemblyName>
    <!-- A runnable consumer, not a shipped package. Like tools/, it is in no
         solution: run it via "dotnet run" against this project (see Program.cs). -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exactly what a real consumer references: the SDK entry (AddCircleAI,
         IAIService, IFailureAnalyst), the capability + skills surface, and memory. -->
    <ProjectReference Include="..\..\src\CircleAI.Hosting\CircleAI.Hosting.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Skills\CircleAI.Skills.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

</Project>
