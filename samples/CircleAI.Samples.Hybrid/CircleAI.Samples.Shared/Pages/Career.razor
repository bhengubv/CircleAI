@*
    Your CV.

    A COPY OF CareerActivity: one card holding the current question, why it is
    being asked, a box to answer in and two buttons; a progress line; then the
    document itself on white, so what you are building is always visible under
    what you are being asked.

    ONE QUESTION AT A TIME, not a form. A form asks somebody with no CV to produce
    one before they can start; a question they can answer in a sentence gets a
    first draft out of a conversation.
*@
@page "/career"
@inject ICareerInterview Interview
@inject ISettings Settings
@inject ISpokenLanguage Spoken
@inject IConversation Talk
@inject NavigationManager Nav

@*
    THE CV HAS ITS OWN LANGUAGE, which is not the app's. Somebody can use the
    phone in English and need the document in Japanese - for a job in Japan, or
    because that is the language the employer reads. A single global language
    forces the interface and the document to agree, which is wrong for exactly the
    people who need this most.
*@
<label class="in-language">
    <span class="in-label">Write my CV in</span>
    <select class="in-select" value="@_language" @onchange="SetLanguage">
        @foreach (var l in Languages)
        {
            <option value="@l.Tag">@l.Name</option>
        }
    </select>
</label>

<div class="card">
    <div class="question">@_step.Question</div>
    <div class="why">@_step.Why</div>

    @if (!_step.Done)
    {
@*
            @bind:event="oninput", NOT value= with @oninput.

            TYPING DROPPED CHARACTERS. "Thabo Mokoena" was stored as "Thbo
            Mooena": a controlled value attribute is re-applied on every render,
            the handler re-renders on every keystroke, and a character arriving
            while that round trip is in flight is overwritten by the value Blazor
            already had. It is the same fault as the settings select snapping
            back, except a select shows you it happened and a text box quietly
            keeps the wrong string - and this one writes the wrong string onto
            somebody's CV, where a mangled surname is the whole point of the
            field.

            @bind owns the element, so the framework does not fight the keystrokes
            it is receiving.
        *@
        <input class="answer" placeholder="Say it or type it"
               aria-label="Your answer"
               @bind="_answer" @bind:event="oninput"
               @onkeydown="OnKey" />
    }

    <div class="buttons">
        @* Two, side by side and equal. The left is the softer option in both
           states, so the position keeps its meaning as the screen changes. *@
        <button class="btn-soft" @onclick="Secondary" disabled="@_busy">
            @(_step.Done ? "Aim it at a job" : Verify)
        </button>
        <button class="btn-primary" @onclick="Primary" disabled="@_busy">
            @(_step.Done ? "Save my CV" : "Next")
        </button>
    </div>
</div>

<div class="progress">@_progress</div>

@*
    The document, on white.

    Not a preview pane that shows something else - it is built from the same
    CvDocument the renderer takes, so what somebody sees here is what comes out.
*@
<div class="paper">
    @foreach (var line in _preview)
    {
        @switch (line.Kind)
        {
            case CvLineKind.Gap:
                <div class="cv-gap"></div>
                break;
            case CvLineKind.Name:
                <div class="cv-name">@line.Text</div>
                break;
            case CvLineKind.Headline:
                <div class="cv-headline">@line.Text</div>
                break;
            case CvLineKind.Section:
                <div class="cv-section">@line.Text</div>
                break;
            case CvLineKind.Entry:
                <div class="cv-entry">@line.Text</div>
                break;
            case CvLineKind.Small:
                <div class="cv-small">@line.Text</div>
                break;
            default:
                <div class="cv-body">@line.Text</div>
                break;
        }
    }
</div>

@if (_saved is not null)
{
    <div class="saved">@_saved</div>
}

@code {
    const string Service = "cv";

    static IReadOnlyList<SampleLanguage> Languages { get; } = SampleLanguages.All.Values
        .OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)
        .ToList();

    string _language = "";   // set from the phone in OnInitializedAsync

    CareerStep _step = new("", "", false, false);
    IReadOnlyList<CvLine> _preview = [];
    string _progress = "";
    string _answer = "";
    string? _saved;
    bool _busy;

    /// <summary>
    /// The script says which answers must be read back before they are kept.
    /// </summary>
    /// <remarks>A mis-heard surname is worse than a blank one.</remarks>
    string Verify => _step.Verify ? "Say it (I will check)" : "Say it";

    protected override async Task OnInitializedAsync()
    {
        // THE PHONE'S ANSWER, NOT ENGLISH. Somebody writing their CV is
        // writing it in their language until they say otherwise.
        var mine = Spoken.Current;
        _language = await Settings.ServiceSettingAsync(Service, "language", mine) ?? mine;
        await Refresh();
    }

    async Task SetLanguage(ChangeEventArgs e)
    {
        _language = e.Value?.ToString() ?? Spoken.Current;
        await Settings.SetServiceSettingAsync(Service, "language", _language);
    }

    async Task Refresh()
    {
        _step = await Interview.StepAsync();
        _preview = await Interview.PreviewAsync();
        _progress = await Interview.ProgressAsync();
    }

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Primary();
    }

    async Task Primary()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (_step.Done)
            {
                _saved = await Interview.SaveAsync();
                return;
            }

            if (!string.IsNullOrWhiteSpace(_answer))
                await Interview.AnswerAsync(_answer);

            _answer = "";
            await Refresh();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Speak the answer instead of typing it.</summary>
    /// <remarks>
    /// THE POINT OF THE WHOLE SCREEN. Somebody who struggles to write is exactly
    /// who needs a CV built for them, and a form they have to type into helps them
    /// least. The words land in the box rather than being submitted, so a
    /// mis-heard surname can be corrected before it is kept - which is what the
    /// script's Verify flag is asking for.
    /// </remarks>
    async Task Secondary()
    {
        if (_step.Done)
        {
            Nav.NavigateTo("job-spec");
            return;
        }

        if (_busy) return;
        _busy = true;

        var updates = new Progress<TurnState>(t =>
        {
            if (t.Heard is { Length: > 0 } heard) _answer = heard;
            _saved = t.Detail;
            InvokeAsync(StateHasChanged);
        });

        // DICTATE, NOT CONVERSE. This called TurnAsync - listen, think, answer
        // aloud - so speaking your own name into your own CV needed the 548 MB
        // answering model, and the screen said ANSWERING was what was missing.
        // Downloading it would not have helped: what this needs is the ears. And
        // a full turn would have taken the name as a question and said something
        // back, when all that was wanted was the words written down.
        try { await Talk.DictateAsync(updates); }
        catch (Exception ex) { _saved = $"{ex.GetType().Name}: {ex.Message}"; }
        finally { _busy = false; }
    }
}
