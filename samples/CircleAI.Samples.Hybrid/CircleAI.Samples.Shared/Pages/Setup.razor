@*
    Setting it up.

    THE FIRST THING ANYBODY MEETS, and until now the only screen the hybrid could
    not show them. Everything verified before this was verified on a phone that had
    already been set up by hand, which is a tour of the happy path rather than a
    test.

    Three things at once, deliberately: what is being fetched, how long the whole
    of it has left, and something worth doing meanwhile. A bar on its own is a
    screen that asks somebody to wait without telling them what for.
*@
@page "/setup"
@inject ISetup Wizard
@inject IResidentAssistant Resident
@inject NavigationManager Nav

<div class="setup">

    @*
        THREE STATES, NOT TWO. Finished was being drawn as still-running: the
        headline said "getting it ready" under a full bar, and the line under it
        said "working out how long this will take" - because the estimate goes to
        zero when there is nothing left to estimate. A screen that has finished
        saying it is still working is the same lie as one that says it is getting
        ready when nothing is downloading.
    *@
    <h1 class="lead">@(_done ? "It is ready" : _running ? "Getting it ready" : _lead)</h1>
    <p class="sub">@Sub</p>

    @if (!_running)
    {
        <div class="plan">
            @foreach (var item in _plan)
            {
                <div class="plan-row">
                    <span class="plan-title">@item.Title</span>
                    <span class="plan-size">@Size(item.Bytes)</span>
                </div>
            }
            @if (_plan.Count > 0)
            {
                @* The total is the number that decides whether somebody on a
                   metered connection starts at all, so it is stated up front
                   rather than discovered halfway through. *@
                <div class="plan-row plan-total">
                    <span class="plan-title">Altogether</span>
                    <span class="plan-size">@Size(_plan.Sum(p => p.Bytes))</span>
                </div>
            }
        </div>

        <button class="start" @onclick="Start" disabled="@(_plan.Count == 0)">
            @(_plan.Count == 0 ? (TooSmall ? "Nothing fits this phone" : "Nothing to fetch") : "Start")
        </button>
    }
    else
    {
        <div class="bar"><span style="width:@($"{_progress.Fraction * 100:0}%")"></span></div>
        <p class="step">
            @_progress.Title
            @if (_progress.Count > 0)
            {
                <span class="of">@(_progress.Index + 1) of @_progress.Count</span>
            }
        </p>

        @* THE WAIT, SPENT. On a slow link this is most of an hour somebody has to
           spend anyway; offering something useful during it is the difference
           between a progress bar and an app. *@
        @foreach (var step in _tour)
        {
            <div class="tour">
                <div class="tour-title">@step.Title</div>
                <div class="tour-body">@step.Body</div>
                @*
                    A "#" ROUTE ACTS HERE; anything else is a place to go.

                    Two of these steps had verbs for labels and routes for
                    behaviour: "Allow the microphone" went to the wake screen,
                    which asked on arrival, so pressing it moved somebody off
                    setup and the system prompt appeared over a page they had not
                    chosen. "Allow it to run" went to this app's own settings,
                    which has never had a battery control on it at all.

                    The same sentinel the bottom bar uses for its voice button,
                    and for the same reason: some controls are things you do, not
                    places you go.
                *@
                @if (step.Action is not null && step.Route is { Length: > 0 } route)
                {
                    @if (route.StartsWith('#'))
                    {
                        <button class="tour-action" disabled="@_asking"
                                @onclick="() => Grant(route)">@step.Action</button>
                    }
                    else
                    {
                        <a class="tour-action" href="@route">@step.Action</a>
                    }
                }
            </div>
        }
    }

    @if (_granted is { Length: > 0 })
    {
        <p class="granted">@_granted</p>
    }

    @if (_done)
    {
        <a class="start" href="">It is ready — take me to the circle</a>
    }
</div>

@code {
    IReadOnlyList<SetupItem> _plan = [];

    /// <summary>
    /// What is actually on the phone, read alongside the plan.
    /// </summary>
    /// <remarks>
    /// NEEDED TO TELL TWO EMPTY PLANS APART - see TooSmall. Nothing planned and
    /// nothing present is a handset that can run none of the catalogue; nothing
    /// planned and everything present is a finished setup. They had the same
    /// wording.
    /// </remarks>
    Census? _census;
    IReadOnlyList<TourStep> _tour = [];
    SetupProgressReport _progress = new(0, 0, "", 0, TimeSpan.Zero);
    bool _running;
    bool _done;
    string? _error;

    string Sub => _error
        ?? (_done
            ? "Everything it needs is on this phone."
            : _running
            ? Remaining
            : _plan.Count == 0
                ? (TooSmall
                    ? "Nothing in the catalogue fits this phone's memory."
                    : "Everything it needs is already here.")
                : "It needs a few things first. They stay on this phone.");

    /// <summary>
    /// An empty plan with an empty phone: everything was refused by the fit check.
    /// </summary>
    /// <remarks>
    /// TWO CAUSES, ONE EMPTY LIST, AND THE WRONG ONE WAS ASSUMED. A plan with no
    /// steps means either "it is all already here" or "not one model in the
    /// catalogue will run on this handset" - and this screen said "Everything it
    /// needs is already here" for BOTH. A person whose phone can run nothing was
    /// congratulated on being fully provisioned.
    /// <para>
    /// The census is what separates them: nothing planned AND nothing present.
    /// The other head has said this since it was written; this one never did.
    /// </para>
    /// </remarks>
    bool TooSmall => _plan.Count == 0 && _census is { Present: 0, Total: > 0 };

    /// <summary>
    /// How long the WHOLE of setup has left, not the current file.
    /// </summary>
    /// <remarks>
    /// A person wants to know when they can use the phone, which is when the last
    /// byte lands. The same bundle is minutes on a premium handset and most of an
    /// hour on a P30 Lite.
    /// </remarks>
    /// <remarks>
    /// AN ESTIMATE IS ONLY HONEST WHILE BYTES ARE MOVING. Checking a 1.3 GB file
    /// takes about a minute on a mid-range phone with the network idle, and no
    /// new reports arrive while it runs - so the countdown FREEZES at whatever it
    /// last said. Measured on a Redmi Note 12 Pro+: "about 20 sec left" held for
    /// over a minute while the phone sat at 267% CPU hashing. Nothing was wrong
    /// and the screen had no way to say so.
    /// <para>
    /// So the phase is asked first. A frozen number is a worse answer than no
    /// number, because a number that has stopped moving is the universal sign of
    /// a hang.
    /// </para>
    /// </remarks>
    string Remaining => _progress.Phase switch
    {
        SetupPhase.Checking => "Checking what arrived…",
        SetupPhase.Done     => "Finishing up…",
        _ => _progress.Remaining <= TimeSpan.Zero
            ? "Working out how long this will take…"
            : _progress.Remaining.TotalMinutes >= 1.5
                ? $"About {_progress.Remaining.TotalMinutes:0} minutes left"
                : $"About {Math.Max(5, _progress.Remaining.TotalSeconds):0} seconds left",
    };

    /// <summary>
    /// The headline before anything starts, taken from readiness.
    /// </summary>
    /// <remarks>
    /// ONE SOURCE FOR THE WORDING. This was the literal "Let's set it up", while
    /// Home - which decides the same thing from the same readiness - says "Finish
    /// setting it up" once part of it is already on the phone. So a half-installed
    /// phone was invited to begin something it was in the middle of, by the screen
    /// that was doing the resuming.
    /// </remarks>
    string _lead = "Let's set it up";

    protected override async Task OnInitializedAsync()
    {
        _lead = (await Wizard.ReadinessAsync()).Headline;
        _plan = await Wizard.PlanAsync();
        _census = await Wizard.CensusAsync();

        // ALREADY GOING. Tapping Home on the bar during an 817 MB download kills
        // this component; coming back built a fresh one that knew nothing, showed
        // the plan again and offered Start - which began a SECOND concurrent
        // download of the same files. Now it re-attaches to the run in flight and
        // shows where it has got to.
        if (Wizard.IsRunning)
        {
            _running = true;
            _tour = await Wizard.TourAsync(TimeSpan.FromMinutes(2));
            await Attach();
        }
    }

    /// <summary>Whether a permission prompt is open, so it cannot be asked twice.</summary>
    bool _asking;

    /// <summary>What the last grant did, in the person's words.</summary>
    string? _granted;

    /// <summary>
    /// Do the thing the button says, here.
    /// </summary>
    /// <remarks>
    /// A phone that has no screen for the vendor exemption gets told what to look
    /// for rather than a button that failed in silence - these components move
    /// between firmwares and there is no list that stays right.
    /// </remarks>
    async Task Grant(string what)
    {
        if (_asking) return;
        _asking = true;
        try
        {
            _granted = what switch
            {
                "#microphone" => await Wizard.AllowMicrophoneAsync()
                    ? "It can hear you now."
                    : "Not allowed. It can still be typed to.",
                "#background" => await Wizard.AllowBackgroundAsync()
                    ? null
                    : "This phone has no screen for that. Find Circle AI in your "
                    + "battery settings and allow it to run in the background.",
                _ => null,
            };
        }
        finally { _asking = false; }
    }

    /// <summary>Follow the run in flight, whether this page started it or not.</summary>
    async Task Attach()
    {
        var progress = new Progress<SetupProgressReport>(p =>
        {
            _progress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await Wizard.RunAsync(progress);
            _done = true;

            // AND NOW THE WAKE BUNDLE EXISTS, SO TRY TO LISTEN.
            //
            // MainLayout calls ResumeAsync ONCE, on firstRender - which happens
            // while the loading screen is still painting, before a single byte of
            // the wake bundle has arrived. StartAsync returns NotInstalled, and
            // nothing ever retried: hands-free worked only after the app had been
            // killed and reopened.
            //
            // The other head started the listener the moment readiness saw the
            // bundle, including mid-download. This is the same moment, at the one
            // point in this head where a download is known to have finished.
            //
            // Not awaited and never fatal: loading a wake bundle is seconds, and
            // a listener that will not come up is a line on the settings screen
            // rather than a reason setup failed.
            if (Resident is not null)
            {
                try { _ = Resident.ResumeAsync(); }
                catch { /* the toggle in Settings reads IsListening live */ }
            }
        }
        catch (Exception ex)
        {
            // The reason, and the state it stopped in. Setup resumes where it
            // died - FirstRun.Plan skips whatever already landed - so saying so
            // is the difference between "try again" and "start over".
            _error = $"Stopped: {ex.Message}. Nothing already fetched is lost — "
                   + "starting again picks up where it left off.";
            _running = false;
            _plan = await Wizard.PlanAsync();
            _census = await Wizard.CensusAsync();
        }
    }

    static string Size(long bytes)
        => bytes >= 1_000_000_000
            ? $"{bytes / 1_000_000_000.0:0.#} GB"
            : $"{bytes / 1_000_000.0:0} MB";

    async Task Start()
    {
        _running = true;
        _error = null;

        // The tour is chosen against the estimate, so it can only be picked once
        // there is one. Rough is fine: it decides how much to offer, not what.
        var estimate = TimeSpan.FromMinutes(Math.Max(2, _plan.Sum(p => p.Bytes) / 6_000_000.0 / 60));
        _tour = await Wizard.TourAsync(estimate);

        await Attach();
    }
}
