<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IT — a runnable reference sample for building an on-device assistant on the
    CircleAI Neuron. Single-file console app; depends only on CircleAI.Hosting
    (which pulls the rest of the SDK). Runs with NO model download — the brain is
    a placeholder generator. Swap that for QwenTextGenerator (MNN) for real
    inference; nothing else changes.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>CircleAI.Assistant</RootNamespace>
    <AssemblyName>it</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The assistant runtime, which now owns the session, the tools and the
         voice. It brings Hosting, Documents, Voice and Assistant with it. -->
    <ProjectReference Include="..\..\src\CircleAI\CircleAI.csproj" />
    <!-- Offline document generation — shared with the Android head (CircleAISession uses it). -->
    <!-- Voice (ONNX TTS) is referenced by the CONSOLE head only. The Android
         head has its own csproj that links this project's *.cs non-recursively,
         so Voice/CircleAISpeaker.cs and this reference never reach the APK. -->
    <!--
      For SampleLanguages, so first-run can NAME the language it is fetching a
      voice for instead of saying "your language". Contracts has zero
      ProjectReferences of its own - a browser loads it - so depending ON it
      cannot create a cycle, and it is where the app's language table already
      lives. Restating that table here would be the fifth copy of one fact.
    -->
    <!-- Capability sweep: every "hands make things" + "systems" library the
         CapabilitySweep exercises end-to-end. All pure-managed / offline. -->
  </ItemGroup>

  <ItemGroup>
    <!-- The capability sweep and the ten libraries it exercises. Its own
         project so that graph is a decision rather than an accident of
         which files a glob happened to pick up. -->
  </ItemGroup>

</Project>
