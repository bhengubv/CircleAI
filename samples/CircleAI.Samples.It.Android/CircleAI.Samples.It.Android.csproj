<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IT — Android head. The SAME C# as the desktop console: it links IT's shared
    core (ItSession + ItGenerator) and drives it from a MainActivity. Build the
    ecosystem's standard way:  dotnet build -f net10.0-android -c Debug -m:1
    then  adb install  the APK. This is "C# IT running on the phone."
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>CircleAI.Samples.It.Mobile</RootNamespace>
    <ApplicationId>com.bhengubv.itsample</ApplicationId>
    <!-- ApplicationVersion is Android's versionCode: it MUST increase on every
         build a user could install over, or the install is refused. It sat at 1
         from the first commit, so no update could ever have replaced an earlier
         copy. Bump it with each build that leaves this machine. -->
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.2</ApplicationDisplayVersion>

    <!-- Plain APK so `adb install` just works (no bundletool step). -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CircleAI.Hosting\CircleAI.Hosting.csproj" />
    <!-- The resident device service + the memory probe every Android head must
         install. This sample is its first consumer, which is what keeps the
         library honest about what a plain (non-MAUI) Android app needs. -->
    <ProjectReference Include="..\..\src\CircleAI.Device\CircleAI.Device.csproj" />
    <!-- Offline document generation (CV, …). Pure-managed PDFsharp — no native .so. -->
    <ProjectReference Include="..\..\src\CircleAI.Documents\CircleAI.Documents.csproj" />
    <!-- Capability sweep: every "hands make things" + "systems" library the
         CapabilitySweep exercises end-to-end. All pure-managed / offline. -->
    <ProjectReference Include="..\..\src\CircleAI.Charts\CircleAI.Charts.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Presentations\CircleAI.Presentations.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Music\CircleAI.Music.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Media\CircleAI.Media.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.BusinessOps\CircleAI.BusinessOps.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Cast\CircleAI.Cast.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Mesh\CircleAI.Mesh.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.CodeAgent\CircleAI.CodeAgent.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Security.Defense\CircleAI.Security.Defense.csproj" />
    <ProjectReference Include="..\..\src\CircleAI.Security.Antibodies\CircleAI.Security.Antibodies.csproj" />
    <!--
      ON-DEVICE VOICE. Opt in with -p:ItVoiceOnAndroid=true.

      OFF by default: it adds ONNX Runtime + whisper.cpp natives (tens of MB) to
      the APK, and mobile TTS additionally needs libespeak-ng.so + espeak-ng-data
      bundled (see NativeEspeakPhonemizer). Kept as a deliberate switch so the
      chat-only APK — the one proven on the Huawei — stays lean.
    -->
    <ProjectReference Include="..\..\src\CircleAI.Voice\CircleAI.Voice.csproj"
                      Condition="'$(ItVoiceOnAndroid)' == 'true'" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ItVoiceOnAndroid)' == 'true'">
    <DefineConstants>$(DefineConstants);IT_VOICE_ANDROID</DefineConstants>
  </PropertyGroup>

  <!-- Voice/ is normally excluded (the *.cs glob below is non-recursive);
       pull it in only when Android voice is switched on. -->
  <ItemGroup Condition="'$(ItVoiceOnAndroid)' == 'true'">
    <Compile Include="..\CircleAI.Samples.It\Voice\*.cs" Link="Shared\Voice\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    RECORD_AUDIO (hands-free voice loop) is declared as an assembly-level
    [UsesPermission] guarded by IT_VOICE_ANDROID — see Permissions.cs. It MUST be in
    the manifest or requestPermissions() is a silent no-op and AudioRecord yields
    only zeroes; the #if keeps it out of the chat-only APK so that build never asks
    for the microphone. A prior <AndroidPermission Include="..."/> item here was a
    no-op (not a recognized .NET Android build item), so it never took effect.
  -->

  <!--
    MNN native libraries are bundled automatically by the repo-root
    Directory.Build.targets — this project needs no native-lib plumbing.

    That file exists because a per-project workaround lived here first, which
    meant every future Android head would have had to rediscover the same trap
    (a build-time omission that only surfaces as DllNotFoundException on a
    physical device). Opt out with <CircleAIBundleMnn>false</CircleAIBundleMnn>.
  -->


  <!--
    Share IT's core source with the console head — one invention, two faces.

    Globbed, not listed file by file. The previous explicit list silently
    dropped any newly added shared file: adding ItToolBridge.cs broke this
    build with "type or namespace not found" pointing at ItSession.cs, which
    reads as a missing using rather than a missing Compile item.

    Program.cs is EXCLUDED deliberately — it is the console's entry point, and
    the Android head has its own (MainActivity). It cannot be globbed in.
  -->
  <ItemGroup>
    <Compile Include="..\CircleAI.Samples.It\*.cs"
             Exclude="..\CircleAI.Samples.It\Program.cs"
             Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
