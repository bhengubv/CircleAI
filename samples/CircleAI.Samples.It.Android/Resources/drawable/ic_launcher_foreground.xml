<?xml version="1.0" encoding="utf-8"?>
<!--
    App icon foreground: THE SAME MARK MarkView DRAWS, projected onto the
    108dp adaptive-icon canvas.

    It used to be a hand-drawn approximation and it had drifted into a different
    logo. The live mark's ring is open at the TOP with an 80-degree gap; this file
    had a half circle open on the RIGHT. The live mark's three arcs fade outward
    (alpha 235, 150, 80) because the outer ones are quieter sound; here all three
    were solid white. Side by side they are not the same object, and nobody
    noticed because the icon and the home screen are never on screen together.

    So every number below is computed from MarkView.OnDraw's own constants —
    ring 0.46r stroke 0.11r, arcs at +0.16r steps stroke 0.085r, ring -50 sweep
    280, arcs -34 sweep 68, idle alphas 235/150/80 — with r = 36.641 chosen so the
    outermost arc plus half its stroke lands exactly on the 36dp safe radius.
    Anything outside that can be cropped away by the launcher's mask.

    Regenerate rather than edit: the geometry belongs to MarkView.
    White on the brand blue background, which is the same pair as the app
    inverted — a launcher icon needs the contrast the home screen gets from its
    dark page.

    Not carried over: the halo. It is a 28-alpha fill behind the mark, and this
    canvas already has a solid blue background, so it would draw nothing.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the ring, open at the top -->
    <path
        android:strokeColor="#ffffff"
        android:strokeWidth="4.03"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 64.83 41.09 A 16.85 16.85 0 1 1 43.17 41.09" />

    <!-- three arcs leaving on the right, fading as they widen: the voice -->
    <path
        android:strokeColor="#ffffff"
        android:strokeAlpha="0.922"
        android:strokeWidth="3.11"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 72.83 41.30 A 22.72 22.72 0 0 1 72.83 66.70" />
    <path
        android:strokeColor="#ffffff"
        android:strokeAlpha="0.588"
        android:strokeWidth="3.11"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 77.69 38.02 A 28.58 28.58 0 0 1 77.69 69.98" />
    <path
        android:strokeColor="#ffffff"
        android:strokeAlpha="0.314"
        android:strokeWidth="3.11"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M 82.55 34.74 A 34.44 34.44 0 0 1 82.55 73.26" />
</vector>
