<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CircleAI Service — the standalone app that OWNS the models.

    NOT A SAMPLE, despite living beside them: every Android head in this repo is
    under samples/, so this is here for consistency rather than status. It is a
    shipping app with its own store listing, and the sample client is a second,
    separate listing.

    WHY IT EXISTS AS ITS OWN PACKAGE. CircleNeuronService's own header gives the
    arithmetic: a 122 MB voice takes 13-23 s to build a session on a P30 Lite, and
    fifteen apps on a 3 GB phone cannot each hold their own copy. Until now the
    HYBRID SAMPLE was the host — LinkIpc.HostPackage literally named it — so
    "the shared brain" was a thing you got by installing a demo. A person who wants
    CircleAI on their phone should install CircleAI, not a sample of it.

    IT SHIPS NO SCREENS WORTH SPEAKING OF, and that is correct. The face here is a
    status page: which models are resident, what this device can do, who is linked.
    Everything a person actually does happens in a client that binds to it.

    THE MANIFEST IS GENERATED FROM ATTRIBUTES in CircleAI.Device, which is why no
    XML here declares anything:
      CircleNeuronLinkService  [Service(Exported = true)] + [IntentFilter(BindAction)]
      LinkConsentActivity      [Activity(Exported = true)] + [IntentFilter(ConsentAction)]
      CircleNeuronService      [Service(ForegroundServiceType = DataSync | Microphone)]
    Referencing CircleAI.Device is what puts them in the package.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <RootNamespace>CircleAI.Service.Android</RootNamespace>

    <!-- MUST match LinkIpc.HostPackage, or every client's IsInstalled() reads
         false and no bind is ever attempted. The two are one fact; the constant
         is the one place it is written down. -->
    <ApplicationId>com.bhengubv.circleai.service</ApplicationId>

    <!-- Android's versionCode. It MUST increase on every build somebody could
         install over, or the install is refused with no useful message. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>

    <!-- Plain APK so `adb install` works without a bundletool step. Also: a
         Release -t:Install of an app bundle UNINSTALLS first and takes the
         downloaded models with it, which on a P30 is gigabytes. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- The resident service, the link service and the consent activity all live
         here. This single reference is what makes this app the host. -->
    <ProjectReference Include="..\..\src\CircleAI.Device\CircleAI.Device.csproj" />

    <!-- The engines. The service owns model selection and loading, so it is the
         one package that needs them; a client has no inference dependency at all,
         which is the entire point of the split. -->
    <ProjectReference Include="..\..\src\CircleAI.Inference\CircleAI.Inference.csproj" />

    <!-- THE SERVICE HALF OF THE ASSISTANT, and without it this app packaged the
         models and wired none of them. VoiceWiring unpacks espeak and installs the
         phonemiser; SkillLibrary opens the 5 MB skill database; ServiceSpeech is
         the recogniser and the voice behind the link's audio transaction. All three
         assets were being shipped here already and nothing opened them. -->
    <ProjectReference Include="..\..\src\CircleAI.Assistant.Device\CircleAI.Assistant.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      espeak-ng AND THE SKILL DATABASE, WHICH CAME ACROSS FROM THE CLIENT. Both
      were in the hybrid sample and neither could be used there: espeak-ng is a
      grapheme-to-phoneme front end for SYNTHESIS, and skills.db is what a MODEL
      looks things up in. This is the process with both.

      arm64 only for the .so - the x86_64 build would need the NDK recipe run
      again - and the library and its data are version-locked at espeak-ng 1.52.0,
      so they move together or not at all.

      espeak-ng is GPL-3.0 and is used OUT OF PROCESS, never linked. That
      arrangement is what keeps it off this app's licence, and it is the reason
      the phonemiser is invoked rather than referenced.
    -->
    <AndroidNativeLibrary Include="..\..\src\CircleAI.Voice\runtimes\android-arm64\native\libespeak-ng.so"
                          Abi="arm64-v8a" />
    <AndroidAsset Include="..\..\src\CircleAI.Voice\assets\espeak-ng-data.zip"
                  Link="espeak-ng-data.zip" />
    <AndroidAsset Include="..\..\src\CircleAI.Skills\assets\skills.db.zip"
                  Link="skills.db.zip" />
  </ItemGroup>

  <!--
    MNN's native libraries are bundled by the repo-root Directory.Build.targets;
    no per-project plumbing. Opt out with <CircleAIBundleMnn>false</CircleAIBundleMnn>.

    The llama.cpp bridge is NOT wired in here yet. libllamabridge.so is built
    (arm64, against PrismML-Eng/llama.cpp prism-b10743-adfffbe) and needs four
    companion libraries — libllama, libggml, libggml-cpu, libggml-base, about
    61 MB together. Adding them is a deliberate step with a real size cost, and
    doing it silently inside the first build of a new head would hide it.
  -->

</Project>
