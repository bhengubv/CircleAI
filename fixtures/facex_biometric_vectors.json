      "confidence": 0.79,
      "expected_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.25,
        "rapport": 0.0, "energy": 0.5
      },
      "tolerance": 1e-5
    },
    {
      "id": "stressed_from_neutral",
      "description": "Stressed expression increments Uncertainty and decrements Energy.",
      "initial_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
