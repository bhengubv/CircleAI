      "initial_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "expression": "Happy",
      "confidence": 0.92,
      "expected_affect": {
        "curiosity": 0.5, "engagement": 0.53, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.52
      },
      "tolerance": 1e-5
    },
    {
      "id": "surprised_from_neutral",
      "description": "Surprised expression increments Curiosity.",
