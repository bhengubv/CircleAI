    {
      "id": "neutral_expression_no_change",
      "description": "Neutral expression must not mutate any axis.",
      "initial_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "expression": "Neutral",
      "confidence": 0.95,
      "expected_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
