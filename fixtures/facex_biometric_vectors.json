        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "expression": "Surprised",
      "confidence": 0.88,
      "expected_affect": {
        "curiosity": 0.54, "engagement": 0.5, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "tolerance": 1e-5
    },
    {
