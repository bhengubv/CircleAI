    {
      "id": "clamp_max_engagement",
      "description": "Happy signal from near-max engagement must clamp at 1.0.",
      "initial_affect": {
        "curiosity": 0.5, "engagement": 0.99, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "expression": "Happy",
      "confidence": 0.95,
      "expected_affect": {
        "curiosity": 0.5, "engagement": 1.0, "uncertainty": 0.2,
