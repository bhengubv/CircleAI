      "tolerance": 1e-5
    },
    {
      "id": "low_confidence_discarded",
      "description": "Confidence below 0.5 must produce no change regardless of expression.",
      "initial_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
        "rapport": 0.0, "energy": 0.5
      },
      "expression": "Stressed",
      "confidence": 0.49,
      "expected_affect": {
        "curiosity": 0.5, "engagement": 0.5, "uncertainty": 0.2,
