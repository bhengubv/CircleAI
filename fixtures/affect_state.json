        "uncertainty": 0.21,
        "rapport": 0.01,
        "energy": 0.5
      }
    },
    {
      "id": "negative_then_positive",
      "description": "Apply negative then positive from the default state.",
      "input": {
        "curiosity": 0.5,
        "engagement": 0.5,
        "uncertainty": 0.2,
        "rapport": 0.0,
        "energy": 0.5
