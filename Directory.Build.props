<Project>
  <PropertyGroup>
    <!-- ========== IDENTITY ========== -->
    <Authors>The Geek Network</Authors>
    <Company>The Other Bhengu (PTY) Ltd</Company>
    <Copyright>Copyright © 2024-2025 The Other Bhengu (PTY) Ltd</Copyright>

    <!-- ========== VERSIONING ========== -->
    <Version>3.6.0</Version>
    <AssemblyVersion>3.6.0.0</AssemblyVersion>
    <FileVersion>3.6.0.0</FileVersion>

    <!-- ========== LANGUAGE ========== -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- ========== NUGET ========== -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageProjectUrl>https://github.com/bhengubv/CircleAI</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bhengubv/CircleAI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>circle-ai;on-device-ai;llm;local-ai;circle;thegeeknetwork</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- ========== BUILD QUALITY ========== -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- ========== PATH RESOLUTION ========== -->
    <PackageIconFullPath>$(MSBuildThisFileDirectory)assets\icon.png</PackageIconFullPath>
    <PackageReadmeFullPath>$(MSBuildThisFileDirectory)README.md</PackageReadmeFullPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- ========== INCLUDED FILES (FIXED PATHS) ========== -->
    <None Include="$(PackageIconFullPath)" Pack="true" PackagePath="\" Condition="Exists('$(PackageIconFullPath)')">
      <Visible>false</Visible>
    </None>
    <None Include="$(PackageReadmeFullPath)" Pack="true" PackagePath="\" Condition="Exists('$(PackageReadmeFullPath)')">
      <Visible>false</Visible>
    </None>

    <!-- ========== PACKAGE REFERENCES ========== -->
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All"/>
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" PrivateAssets="All"/>
  </ItemGroup>

  <Target Name="ValidatePackageAssets" BeforeTargets="Pack">
    <Error Text="Required package icon not found at $(PackageIconFullPath)"
           Condition="!Exists('$(PackageIconFullPath)')"/>
    <Error Text="Required README not found at $(PackageReadmeFullPath)"
           Condition="!Exists('$(PackageReadmeFullPath)')"/>
  </Target>

  <!--
    ============================================================================
    ANDROID RELEASE SIGNING

    BOTH APKs WERE DEBUG-SIGNED AND NOTHING SAID SO. A Release Android build with
    no signing configured does not fail - MAUI/the Android SDK quietly fall back
    to the platform debug keystore, so you get a Release APK that installs, runs,
    passes every test, and cannot be uploaded anywhere. Checked on a P30 on
    2026-10-01: both packages carried the debug signature.

    THE KEY ALREADY EXISTED. TheGeekAlias.keystore is the same key the seventeen
    apps under thegeeknetwork\code use, wired there in exactly this way; this repo
    was simply never given the block. One key, so a person who already trusts one
    of these apps is not asked to trust a second identity for the engine behind it.

    THE PASSWORD IS NEVER IN A FILE. It comes from ANDROID_KEYSTORE_PASS in the
    environment, which is the only reason this block can be committed at all.

    Operator setup, once per machine:
      1. The keystore at %USERPROFILE%\keystore\TheGeekAlias.keystore
         (thegeeknetwork\Deployment\Setup-DeployMachine.ps1 puts it there, or copy it
         from %LOCALAPPDATA%\Xamarin\Mono for Android\Keystore\TheGeekAlias\).
      2. setx ANDROID_KEYSTORE_PASS "<from the password manager>"
      3. OPEN A NEW SHELL. setx does not touch the one you typed it in.

    Until then, -p:CircleAIAllowDebugSignedRelease=true builds a debug-signed Release
    package so on-device testing can carry on. It warns on every build and the result
    must never leave the bench.

    PACKAGE FORMAT IS DELIBERATELY NOT SET HERE. thegeeknetwork's copy of this block
    forces aab, which is a Play Store format; this product is degoogled and ships an
    APK, and a Release -t:Install of an app bundle uninstalls first and takes the
    downloaded models with it. CircleAIService.csproj sets apk for itself and says
    why; nothing shared may override that.
    ============================================================================
  -->
  <PropertyGroup Condition="$(TargetFramework.Contains('-android')) AND '$(Configuration)' == 'Release' AND '$(CircleAIAllowDebugSignedRelease)' != 'true'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' == '' AND '$(UserProfile)' != ''">$(UserProfile)\keystore\TheGeekAlias.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyStore Condition="'$(AndroidSigningKeyStore)' == ''">$(HOME)/keystore/TheGeekAlias.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias Condition="'$(AndroidSigningKeyAlias)' == ''">TheGeekAlias</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>$(ANDROID_KEYSTORE_PASS)</AndroidSigningKeyPass>
    <AndroidSigningStorePass>$(ANDROID_KEYSTORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <!--
    SAY WHICH OF THE TWO IS MISSING, BEFORE THE BUILD SPENDS TEN MINUTES ON IT.
    Without this the failure is MSB4044 "required parameter KeyPass" from
    AndroidSignPackage, at the very end of a Release build, which names neither the
    variable nor the file. Both checks are errors rather than warnings on purpose:
    the silent fallback to the debug key is the defect this whole block exists to
    stop, and a warning in a build this size is a thing nobody reads.

    BEFORE PrepareForBuild, WHICH IS THE ONLY HOOK THAT PROVED TO RUN FIRST.
    BeforeTargets="Build" fires AFTER $(BuildDependsOn) - which already contains the
    signing - so the first cut never ran at all and XA4314 won. Hooking the Android
    SDK's own _ResolveAndroidSigningKey did not fire either. PrepareForBuild is
    documented, stable, in Microsoft.Common.targets rather than the Android SDK, and
    runs before anything in the inner build - measured, not assumed.

    AndroidApplication, NOT OutputType. The csproj says <OutputType>Exe</OutputType>
    and the property still evaluates to "Library" - the Android SDK rewrites it,
    because an APK's entry point is Android's, not a CLR Main. Measured with
    `dotnet msbuild -getProperty:OutputType`, which is also how the first condition
    was found to be silently false: a Target whose Condition does not hold is
    skipped without a word, so the guard looked wired and did nothing, twice.
    AndroidApplication reads true for CircleAIService and false for every android
    class library, which is the question actually being asked. It is only available
    at execution time, which is why the PropertyGroup above cannot use it - a
    Directory.Build.props PropertyGroup is evaluated before the SDK sets it.
  -->
  <Target Name="CircleAIRequireSigningKey" BeforeTargets="PrepareForBuild"
          Condition="'$(AndroidApplication)' == 'true' AND '$(Configuration)' == 'Release'">

    <!--
      THE ESCAPE HATCH IS NAMED, AND IT COMPLAINS EVERY TIME.
      A hard error with no way past it would also stop the Release -t:Install loop
      that every on-device test runs through, on any machine where the password has
      not been set yet - so there is one, and it has to be typed out in full on the
      command line, which means nobody reaches it by accident and it is visible in
      whatever log the build lands in.
    -->
    <Warning Condition="'$(CircleAIAllowDebugSignedRelease)' == 'true'"
             Text="This Release package is signed with Android's DEBUG key because CircleAIAllowDebugSignedRelease=true was passed. It will install and run; it cannot be shipped to anyone." />

    <Error Condition="'$(CircleAIAllowDebugSignedRelease)' != 'true' AND !Exists('$(AndroidSigningKeyStore)')"
           Text="Release Android builds must be signed with the release key, and it is not at $(AndroidSigningKeyStore). Run thegeeknetwork\Deployment\Setup-DeployMachine.ps1, or copy TheGeekAlias.keystore there yourself. Building Release without it would silently produce a debug-signed package." />
    <Error Condition="'$(CircleAIAllowDebugSignedRelease)' != 'true' AND '$(ANDROID_KEYSTORE_PASS)' == ''"
           Text="ANDROID_KEYSTORE_PASS is not set, so $(AndroidSigningKeyStore) cannot be opened. Run: setx ANDROID_KEYSTORE_PASS &quot;&lt;from the password manager&gt;&quot; - then open a NEW shell, because setx does not touch the current one." />
  </Target>
</Project>
