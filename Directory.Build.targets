<!--
  Directory.Build.targets  (CircleAI repo root)
  ═══════════════════════════════════════════════════════════════════════════
  Android native-library bundling for every in-repo Android head.

  WHY THIS FILE EXISTS
  ──────────────────────────────────────────────────────────────────────────
  CircleAI.Inference.targets already knows how to register MNN as
  AndroidNativeLibrary — but it is imported by CircleAI.Inference.csproj
  ITSELF (see that csproj, ~line 72). An <Import> inside a csproj evaluates in
  THAT project's build, where TargetPlatformIdentifier is 'net10.0' and never
  'android'. So the Android block could never fire across a ProjectReference.
  It only works when the SDK is consumed as a NuGet package, where the targets
  land in the consumer's build context.

  The consequence, measured on a Huawei MAR-LX1M on 2026-07-20: the APK shipped
  with ZERO MNN libraries, the 433 MB model downloaded perfectly, and the first
  inference died with "System.DllNotFoundException: mnnbridge". A build-time
  omission surfacing as a runtime crash, on the SDK's headline capability.

  Directory.Build.targets is auto-imported by every project beneath this
  directory, so it evaluates in the ANDROID HEAD's context — which is the one
  place TargetPlatformIdentifier is actually 'android'.

  WHY ALL THE .so, NOT JUST TWO
  ──────────────────────────────────────────────────────────────────────────
  CircleAI.Inference.targets lists only libmnnbridge.so + libMNN.so. The
  shipped runtime is eight files (libMNN_Express, libMNN_CL, libMNN_Vulkan,
  libmnncore, libMNNAudio, libMNNOpenCV as well). Bundling a partial set risks
  a dlopen failure on the dependency chain, so this globs the directory.

  WHY BUNDLE ON ANDROID AT ALL
  ──────────────────────────────────────────────────────────────────────────
  The SDK's default is runtime-fetch (CircleAIBundleMnn=false) — sensible on a
  server. On a phone it is not: it spends the user's mobile data on ~8 MB that
  compresses into the APK anyway, and dlopen from an app-data directory is far
  less reliable across Android versions than the OS-managed lib/ directory.
  So Android defaults to bundling here.

  OPTING OUT
  ──────────────────────────────────────────────────────────────────────────
  An Android head that does not use on-device inference can set
  <CircleAIBundleMnn>false</CircleAIBundleMnn> and keep a thinner APK.

  THE SAME TRAP, A SECOND TIME: WHISPER
  ──────────────────────────────────────────────────────────────────────────
  Whisper.net.Runtime DOES ship Android natives, in build/android-arm64-v8a/.
  Its own .targets registers them as AndroidNativeLibrary — but gated on
  $(AndroidSupportedAbis), and that property is empty everywhere except an
  Android head. The package is referenced by CircleAI.Voice, a plain net10.0
  library, so the gate is evaluated there and never opens. Identical shape to
  the MNN story above: a native library that ships, is never bundled, and says
  nothing until a device tries to use it.

  Measured on the P30 on 2026-08-04, running the full voice loop for the first
  time: Talking worked, the ggml-tiny model downloaded and verified, the
  abilities screen said "Listening ✓ On" — and the loop died with
  "[voice] failed: libwhisper". The APK contained libaot-Whisper.net.dll.so,
  the MANAGED wrapper, and no libwhisper.so at all. An ability reporting itself
  as ON while its runtime is absent is the worst version of this bug, because
  the UI is confidently wrong.
-->
<Project>

  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <!-- Bundle by default on Android. Reuses the SDK's existing knob name. -->
    <CircleAIBundleMnn Condition="'$(CircleAIBundleMnn)' == ''">true</CircleAIBundleMnn>
    <!-- src/CircleAI.Inference/ became src/CircleAI/Inference/ at 3.8.1. The old path
         survived the move, matched nothing, and the includes below are wildcards - so
         MNN silently stopped being bundled. The result was a 74 MB signed APK carrying
         291 native libraries and not one of them MNN: the exact nightmare the header of
         this file describes. Embeddings.Local and Voice carry natives too and were never
         covered here at all, so turbovec was equally absent. -->
    <_CircleAIMnnRoot>$(MSBuildThisFileDirectory)src/CircleAI/Inference/runtimes/</_CircleAIMnnRoot>
    <_CircleAITurboVecRoot>$(MSBuildThisFileDirectory)src/CircleAI/Embeddings.Local/runtimes/</_CircleAITurboVecRoot>
    <_CircleAIVoiceRoot>$(MSBuildThisFileDirectory)src/CircleAI/Voice/runtimes/</_CircleAIVoiceRoot>
  </PropertyGroup>

  <!--
    Wildcards that match nothing are silently empty, so an absent RID folder
    (e.g. android-x64) costs nothing and needs no Exists() guard.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' And '$(CircleAIBundleMnn)' == 'true'">
    <AndroidNativeLibrary Include="$(_CircleAIMnnRoot)android-arm64/native/*.so;$(_CircleAITurboVecRoot)android-arm64/native/*.so;$(_CircleAIVoiceRoot)android-arm64/native/*.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_CircleAIMnnRoot)android-arm/native/*.so;$(_CircleAITurboVecRoot)android-arm/native/*.so;$(_CircleAIVoiceRoot)android-arm/native/*.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_CircleAIMnnRoot)android-x64/native/*.so;$(_CircleAITurboVecRoot)android-x64/native/*.so;$(_CircleAIVoiceRoot)android-x64/native/*.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    Whisper's natives, from wherever NuGet restored the runtime package. The
    path is resolved from the package reference rather than hard-coded, so a
    version bump does not silently stop bundling them.
  -->
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <CircleAIBundleWhisper Condition="'$(CircleAIBundleWhisper)' == ''">true</CircleAIBundleWhisper>
    <_WhisperRuntimeRoot Condition="'$(_WhisperRuntimeRoot)' == '' And '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/</_WhisperRuntimeRoot>
    <_WhisperRuntimeRoot Condition="'$(_WhisperRuntimeRoot)' == ''">$(UserProfile)/.nuget/packages/whisper.net.runtime/1.8.1/build/</_WhisperRuntimeRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' And '$(CircleAIBundleWhisper)' == 'true'">
    <!-- libwhisper.so needs its ggml siblings; bundling only the first is a
         dlopen failure one link further down the chain. Glob, do not list. -->
    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-arm64-v8a/*.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-x86_64/*.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-x86/*.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    Build-time visibility. The failure this replaces was invisible until first
    inference on a physical device, so say plainly what did or did not ship.
  -->
  <Target Name="_CircleAIReportAndroidNativeLibs"
          BeforeTargets="Build"
          Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <Message Importance="high"
             Condition="'$(CircleAIBundleMnn)' == 'true' And '@(AndroidNativeLibrary)' != ''"
             Text="[CircleAI] Bundling @(AndroidNativeLibrary->Count()) native lib(s) into the APK." />

    <!--
      THESE THREE CHECKS NAME A FILE, BECAUSE THE ONE THEY REPLACE COUNTED A LIST.

      CIRCLEAI001 used to fire on '@(AndroidNativeLibrary)' == '' — the total
      across every family. Whisper and espeak populate that item unconditionally,
      so the total was never empty and the warning COULD NOT FIRE. That is not a
      hypothetical: the v3.8.1 APKs shipped 291 native libraries with zero MNN and
      zero turbovec, and this target printed a cheerful "Bundling 291 native
      lib(s)" over the top of it. A guard whose condition cannot be met is worse
      than no guard, because it reads like coverage.

      CIRCLEAI002 already had the right shape — !Exists() on one named file — and
      it is the reason the whisper gap was caught. Each family now gets the same,
      and each one names the symptom a person would actually see.
    -->
    <Warning Code="CIRCLEAI001"
             Condition="'$(CircleAIBundleMnn)' == 'true' And !Exists('$(_CircleAIMnnRoot)android-arm64/native/libMNN.so')"
             Text="[CircleAI] No libMNN.so under $(_CircleAIMnnRoot)android-arm64/native/. On-device inference will fail at runtime with DllNotFoundException: mnnbridge, while the abilities screen still offers model downloads." />
    <Warning Code="CIRCLEAI003"
             Condition="'$(CircleAIBundleMnn)' == 'true' And !Exists('$(_CircleAITurboVecRoot)android-arm64/native/libturbovecbridge.so')"
             Text="[CircleAI] No libturbovecbridge.so under $(_CircleAITurboVecRoot)android-arm64/native/. Local embeddings and semantic recall will fail on device; retrieval silently returns nothing rather than erroring." />
    <Warning Code="CIRCLEAI004"
             Condition="'$(CircleAIBundleMnn)' == 'true' And !Exists('$(_CircleAIVoiceRoot)android-arm64/native/libespeak-ng.so')"
             Text="[CircleAI] No libespeak-ng.so under $(_CircleAIVoiceRoot)android-arm64/native/. Phonemization fails on device, so speech comes out with no phonemes rather than failing loudly." />

    <!--
      THE GGUF ENGINE, AND ITS WHOLE DEPENDENCY CHAIN. libllamabridge.so is a thin
      shim: it NEEDS libllama, libggml, libggml-cpu and libggml-base, and bundling
      the shim alone is a dlopen failure one link further down - the exact mistake
      the header of this file warns about for whisper's ggml siblings.
      So the check names the DEEPEST dependency, not the shim: libggml-base is the
      leaf, and if it is present the four above it were staged in the same copy.
      libllamabridge is checked too, because it is the one a p/invoke names and the
      one whose absence logs "Shared library 'llamabridge' not loaded".
      These were built on 2026-09-28 into native/llama-bridge/build-android/, which
      is gitignored, and sat there unstaged until 2026-10-09 - built, working, and
      never shipped. Same shape as the MNN bug, found the same way: by reading what
      a device actually said.
    -->
    <Warning Code="CIRCLEAI005"
             Condition="'$(CircleAIBundleMnn)' == 'true' And Exists('$(_CircleAIMnnRoot)android-arm64/native/libllamabridge.so') And !Exists('$(_CircleAIMnnRoot)android-arm64/native/libggml-base.so')"
             Text="[CircleAI] libllamabridge.so is staged but libggml-base.so is not. The GGUF engine will fail at dlopen with a missing dependency rather than reporting no backend - LlamaInterop.TryGetVersion returns null and the catalogue's PTQ1_0 chat model becomes unusable with no stated reason. Copy libllama.so, libggml.so, libggml-cpu.so and libggml-base.so from native/llama-bridge/build-android/bin/." />

    <!--
      ONLY A PROJECT THAT ACTUALLY BUILDS AN APK MAY SAY ANYTHING ABOUT ONE.
      This message used to fire on every android build of the LIBRARY, which
      produces no APK, announcing "no MNN in the APK" while the head's APK
      carried eight MNN libraries. After the real MNN bug, a false reassurance in
      the opposite direction is the last thing this file should emit.

      WHY THE LIBRARY READS false AND THE HEAD READS true - one fact, two owners:
        Directory.Build.targets:67            defaults it to TRUE  (android)
        src/CircleAI/Inference/
          CircleAI.Inference.targets:75       defaults it to FALSE (any platform)
      Both are guarded on '== null or empty', so the FIRST evaluation wins.
      CircleAI.csproj <Import>s Inference.targets in its body, which is evaluated
      before Directory.Build.targets is imported at the end - so the library gets
      false. CircleAIService only project-references the library, never imports
      that file, so it gets true. Measured with -getProperty:CircleAIBundleMnn,
      not inferred.
      Both defaults are deliberate: false is the SHIPPED default for NuGet
      consumers ("fetch at runtime, sensible on a server"), true is the
      repo-local default for our own android heads. The bug was never the values,
      it was a library being asked about an APK.
    -->
    <Message Importance="high"
             Condition="'$(TargetPlatformIdentifier)' == 'android' And '$(OutputType)' == 'Exe' And '$(CircleAIBundleMnn)' != 'true'"
             Text="[CircleAI] CircleAIBundleMnn=false — no MNN in this APK. On-device inference requires a runtime fetch." />

    <!-- Whisper gets its OWN check. Counting all native libraries together
         would let a full set of MNN mask a completely absent whisper, which is
         exactly how this shipped: 163 libraries in the APK and not one of them
         the one the ears needed. -->
    <Warning Code="CIRCLEAI002"
             Condition="'$(CircleAIBundleWhisper)' == 'true' And !Exists('$(_WhisperRuntimeRoot)android-arm64-v8a/libwhisper.so')"
             Text="[CircleAI] No libwhisper.so under $(_WhisperRuntimeRoot). Speech recognition will fail on device with 'failed: libwhisper' while the abilities screen still reports Listening as ON." />
  </Target>

  <!--
    GLIBC NATIVES MUST NOT REACH AN ANDROID APK.

    Microsoft.ML.OnnxRuntime ships Android support as an AAR, and separately
    ships runtimes/linux-arm64/native/libonnxruntime.so for desktop Linux. The
    .NET RID graph lets android-arm64 fall back through linux-bionic-arm64 to
    linux-arm64, so NuGet offers that LINUX file to an ANDROID build. Both are
    named libonnxruntime.so and both want lib/arm64-v8a/, so the RID-resolved
    one overwrote the AAR's and the APK shipped a binary needing libc.so.6 and
    libdl.so.2 - glibc names that do not exist on bionic. It cannot load:

        System.DllNotFoundException: libonnxruntime.so

    Measured on a P30 2026-09-02: the wake word could not start in the hybrid
    head, and had never been able to. The AAR's own library is fine (19.1 MB,
    needs libc.so / libdl.so / libm.so) and takes over once the impostor is gone.

    Only packages whose Android build arrives as an AAR are exposed to this.
    SourceGear.sqlite3 ships a real runtimes/android-*/native/ folder, so its
    Android asset wins its own name - libe_sqlite3.so is correctly bionic in the
    same APK, which is why SQLite worked while ONNX did not.

    linux-bionic-* is deliberately NOT filtered: those RIDs ARE Android.
  -->
  <Target Name="CircleAIDropGlibcNativesFromAndroid"
          Condition="'$(TargetPlatformIdentifier)' == 'android'"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_CopyFilesMarkedCopyLocal;_BuildApkFastDev;_CreateBaseApk;ProcessNativeLibraries">
    <ItemGroup>
      <_CircleAIGlibcNative Include="@(ResolvedFileToPublish)"
                            Condition="$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-')) And !$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-bionic'))" />
      <ResolvedFileToPublish Remove="@(_CircleAIGlibcNative)" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-')) And !$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-bionic'))" />
    </ItemGroup>
    <Message Importance="high"
             Condition="'@(_CircleAIGlibcNative)' != ''"
             Text="[CircleAI] Dropped @(_CircleAIGlibcNative->Count()) glibc native(s) that the RID graph offered to this Android build." />
  </Target>

  <!--
    A RELEASE APK THAT IS NOT SIGNED WITH THE SHARED KEY IS NOT A FAILING BUILD.
    ──────────────────────────────────────────────────────────────────────────
    Directory.Build.props already explains the hazard at length: with
    AndroidKeyStore unset the SDK's _ResolveAndroidSigningKey falls back to the
    platform debug keystore, and you get a Release APK that installs, runs, passes
    every suite, and can be shipped nowhere. The explanation was written on
    2026-10-01 and nothing enforced it.

    So on 2026-10-02 and 2026-10-03, with the block in place and
    ANDROID_KEYSTORE_PASS correctly unset on the dev box, two Release APKs were
    built and both were wrong - and both builds exited 0:

      com.bhengubv.circleai.hybrid-Signed.apk    debug certificate (O=Android, C=US)
      com.bhengubv.circleai.service-Signed.apk   DOES NOT VERIFY - no META-INF/MANIFEST.MF

    The "-Signed" in the filename is not a claim about the signer. Only what
    apksigner reports for the certificate is; the exact command is in the Message
    at the bottom of this target, where a flag may legally contain two hyphens.

    THREE WAYS THIS GUARD WOULD SILENTLY DO NOTHING, all hit before:
      - BeforeTargets="Build" runs AFTER $(BuildDependsOn), which already contains
        the signing. Hence PrepareForBuild.
      - Hooking _ResolveAndroidSigningKey does not fire at all.
      - '$(OutputType)' == 'Exe' is FALSE for an Android app: the csproj says Exe
        and the SDK rewrites it to Library. Gate on AndroidApplication, which is
        execution-time only - which is also why this lives in a Target and cannot
        be a PropertyGroup condition in Directory.Build.props.

    The password is never an environment variable on a dev box. It is read per
    invocation from thegeeknetwork\Deployment\deployment-credentials.ps1
    ($SIGNING_CREDENTIALS.ANDROID_KEYSTORE_PASSWORD) and passed as -p:, or Visual
    Studio's Archive flow supplies it from TheGeekAlias.keyInfo. Debug builds never
    reach here, so nothing blocks testing.
  -->
  <Target Name="_CircleAIRefuseUnsignedRelease"
          BeforeTargets="PrepareForBuild"
          Condition="'$(Configuration)' == 'Release'
                     And '$(TargetPlatformIdentifier)' == 'android'
                     And '$(AndroidApplication)' == 'true'">

    <Error Code="CIRCLEAI010"
           Condition="'$(AndroidKeyStore)' != 'true'"
           Text="[CircleAI] Release Android build with AndroidKeyStore != true. The SDK would fall back to the platform DEBUG keystore and still exit 0, producing an APK that installs and runs and can be shipped nowhere. Build Debug, or supply the signing properties." />

    <Error Code="CIRCLEAI011"
           Condition="'$(AndroidSigningKeyPass)' == '' Or '$(AndroidSigningStorePass)' == ''"
           Text="[CircleAI] Release Android build with no signing password, so the APK would come out debug-signed or with no MANIFEST.MF. Pass it for this invocation only - read $SIGNING_CREDENTIALS.ANDROID_KEYSTORE_PASSWORD from thegeeknetwork\Deployment\deployment-credentials.ps1 and add -p:AndroidSigningKeyPass=... -p:AndroidSigningStorePass=... - or use Visual Studio's Archive flow. Never setx it." />

    <Error Code="CIRCLEAI012"
           Condition="'$(AndroidSigningKeyStore)' != '' And !Exists('$(AndroidSigningKeyStore)')"
           Text="[CircleAI] Release Android build points at a keystore that is not there: '$(AndroidSigningKeyStore)'. Canonical copy lives under %LOCALAPPDATA%\Xamarin\Mono for Android\Keystore\TheGeekAlias\." />

    <Message Importance="high"
             Text="[CircleAI] Release APK will be signed with alias '$(AndroidSigningKeyAlias)'. Verify the artefact with: apksigner verify --print-certs &lt;apk&gt;" />
  </Target>

</Project>
