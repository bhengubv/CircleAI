<!--
  Directory.Build.targets  (CircleAI repo root)
  ═══════════════════════════════════════════════════════════════════════════
  Android native-library bundling for every in-repo Android head.

  WHY THIS FILE EXISTS
  ──────────────────────────────────────────────────────────────────────────
  CircleAI.Inference.targets already knows how to register MNN as
  AndroidNativeLibrary — but it is imported by CircleAI.Inference.csproj
  ITSELF (see that csproj, ~line 72). An <Import> inside a csproj evaluates in
  THAT project's build, where TargetPlatformIdentifier is 'net10.0' and never
  'android'. So the Android block could never fire across a ProjectReference.
  It only works when the SDK is consumed as a NuGet package, where the targets
  land in the consumer's build context.

  The consequence, measured on a Huawei MAR-LX1M on 2026-07-20: the APK shipped
  with ZERO MNN libraries, the 433 MB model downloaded perfectly, and the first
  inference died with "System.DllNotFoundException: mnnbridge". A build-time
  omission surfacing as a runtime crash, on the SDK's headline capability.

  Directory.Build.targets is auto-imported by every project beneath this
  directory, so it evaluates in the ANDROID HEAD's context — which is the one
  place TargetPlatformIdentifier is actually 'android'.

  WHY ALL THE .so, NOT JUST TWO
  ──────────────────────────────────────────────────────────────────────────
  CircleAI.Inference.targets lists only libmnnbridge.so + libMNN.so. The
  shipped runtime is eight files (libMNN_Express, libMNN_CL, libMNN_Vulkan,
  libmnncore, libMNNAudio, libMNNOpenCV as well). Bundling a partial set risks
  a dlopen failure on the dependency chain, so this globs the directory.

  WHY BUNDLE ON ANDROID AT ALL
  ──────────────────────────────────────────────────────────────────────────
  The SDK's default is runtime-fetch (CircleAIBundleMnn=false) — sensible on a
  server. On a phone it is not: it spends the user's mobile data on ~8 MB that
  compresses into the APK anyway, and dlopen from an app-data directory is far
  less reliable across Android versions than the OS-managed lib/ directory.
  So Android defaults to bundling here.

  OPTING OUT
  ──────────────────────────────────────────────────────────────────────────
  An Android head that does not use on-device inference can set
  <CircleAIBundleMnn>false</CircleAIBundleMnn> and keep a thinner APK.

  THE SAME TRAP, A SECOND TIME: WHISPER
  ──────────────────────────────────────────────────────────────────────────
  Whisper.net.Runtime DOES ship Android natives, in build/android-arm64-v8a/.
  Its own .targets registers them as AndroidNativeLibrary — but gated on
  $(AndroidSupportedAbis), and that property is empty everywhere except an
  Android head. The package is referenced by CircleAI.Voice, a plain net10.0
  library, so the gate is evaluated there and never opens. Identical shape to
  the MNN story above: a native library that ships, is never bundled, and says
  nothing until a device tries to use it.

  Measured on the P30 on 2026-08-04, running the full voice loop for the first
  time: Talking worked, the ggml-tiny model downloaded and verified, the
  abilities screen said "Listening ✓ On" — and the loop died with
  "[voice] failed: libwhisper". The APK contained libaot-Whisper.net.dll.so,
  the MANAGED wrapper, and no libwhisper.so at all. An ability reporting itself
  as ON while its runtime is absent is the worst version of this bug, because
  the UI is confidently wrong.
-->
<Project>

  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <!-- Bundle by default on Android. Reuses the SDK's existing knob name. -->
    <CircleAIBundleMnn Condition="'$(CircleAIBundleMnn)' == ''">true</CircleAIBundleMnn>
    <_CircleAIRuntimesRoot>$(MSBuildThisFileDirectory)src/CircleAI.Inference/runtimes/</_CircleAIRuntimesRoot>
  </PropertyGroup>

  <!--
    Wildcards that match nothing are silently empty, so an absent RID folder
    (e.g. android-x64) costs nothing and needs no Exists() guard.
  -->
  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' And '$(CircleAIBundleMnn)' == 'true'">
    <AndroidNativeLibrary Include="$(_CircleAIRuntimesRoot)android-arm64/native/*.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_CircleAIRuntimesRoot)android-arm/native/*.so">
      <Abi>armeabi-v7a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_CircleAIRuntimesRoot)android-x64/native/*.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    Whisper's natives, from wherever NuGet restored the runtime package. The
    path is resolved from the package reference rather than hard-coded, so a
    version bump does not silently stop bundling them.
  -->
  <PropertyGroup Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <CircleAIBundleWhisper Condition="'$(CircleAIBundleWhisper)' == ''">true</CircleAIBundleWhisper>
    <_WhisperRuntimeRoot Condition="'$(_WhisperRuntimeRoot)' == '' And '$(NuGetPackageRoot)' != ''">$(NuGetPackageRoot)whisper.net.runtime/1.8.1/build/</_WhisperRuntimeRoot>
    <_WhisperRuntimeRoot Condition="'$(_WhisperRuntimeRoot)' == ''">$(UserProfile)/.nuget/packages/whisper.net.runtime/1.8.1/build/</_WhisperRuntimeRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetPlatformIdentifier)' == 'android' And '$(CircleAIBundleWhisper)' == 'true'">
    <!-- libwhisper.so needs its ggml siblings; bundling only the first is a
         dlopen failure one link further down the chain. Glob, do not list. -->
    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-arm64-v8a/*.so">
      <Abi>arm64-v8a</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-x86_64/*.so">
      <Abi>x86_64</Abi>
    </AndroidNativeLibrary>

    <AndroidNativeLibrary Include="$(_WhisperRuntimeRoot)android-x86/*.so">
      <Abi>x86</Abi>
    </AndroidNativeLibrary>
  </ItemGroup>

  <!--
    Build-time visibility. The failure this replaces was invisible until first
    inference on a physical device, so say plainly what did or did not ship.
  -->
  <Target Name="_CircleAIReportAndroidNativeLibs"
          BeforeTargets="Build"
          Condition="'$(TargetPlatformIdentifier)' == 'android'">
    <Message Importance="high"
             Condition="'$(CircleAIBundleMnn)' == 'true' And '@(AndroidNativeLibrary)' != ''"
             Text="[CircleAI] Bundling @(AndroidNativeLibrary->Count()) native lib(s) into the APK." />
    <Warning Code="CIRCLEAI001"
             Condition="'$(CircleAIBundleMnn)' == 'true' And '@(AndroidNativeLibrary)' == ''"
             Text="[CircleAI] CircleAIBundleMnn is true but no MNN native libraries were found under $(_CircleAIRuntimesRoot). On-device inference will fail at runtime with DllNotFoundException: mnnbridge." />
    <Message Importance="high"
             Condition="'$(CircleAIBundleMnn)' != 'true'"
             Text="[CircleAI] CircleAIBundleMnn=false — no MNN in the APK. On-device inference requires a runtime fetch." />

    <!-- Whisper gets its OWN check. Counting all native libraries together
         would let a full set of MNN mask a completely absent whisper, which is
         exactly how this shipped: 163 libraries in the APK and not one of them
         the one the ears needed. -->
    <Warning Code="CIRCLEAI002"
             Condition="'$(CircleAIBundleWhisper)' == 'true' And !Exists('$(_WhisperRuntimeRoot)android-arm64-v8a/libwhisper.so')"
             Text="[CircleAI] No libwhisper.so under $(_WhisperRuntimeRoot). Speech recognition will fail on device with 'failed: libwhisper' while the abilities screen still reports Listening as ON." />
  </Target>

  <!--
    GLIBC NATIVES MUST NOT REACH AN ANDROID APK.

    Microsoft.ML.OnnxRuntime ships Android support as an AAR, and separately
    ships runtimes/linux-arm64/native/libonnxruntime.so for desktop Linux. The
    .NET RID graph lets android-arm64 fall back through linux-bionic-arm64 to
    linux-arm64, so NuGet offers that LINUX file to an ANDROID build. Both are
    named libonnxruntime.so and both want lib/arm64-v8a/, so the RID-resolved
    one overwrote the AAR's and the APK shipped a binary needing libc.so.6 and
    libdl.so.2 - glibc names that do not exist on bionic. It cannot load:

        System.DllNotFoundException: libonnxruntime.so

    Measured on a P30 2026-09-02: the wake word could not start in the hybrid
    head, and had never been able to. The AAR's own library is fine (19.1 MB,
    needs libc.so / libdl.so / libm.so) and takes over once the impostor is gone.

    Only packages whose Android build arrives as an AAR are exposed to this.
    SourceGear.sqlite3 ships a real runtimes/android-*/native/ folder, so its
    Android asset wins its own name - libe_sqlite3.so is correctly bionic in the
    same APK, which is why SQLite worked while ONNX did not.

    linux-bionic-* is deliberately NOT filtered: those RIDs ARE Android.
  -->
  <Target Name="CircleAIDropGlibcNativesFromAndroid"
          Condition="'$(TargetPlatformIdentifier)' == 'android'"
          AfterTargets="ComputeResolvedFilesToPublishList"
          BeforeTargets="_CopyFilesMarkedCopyLocal;_BuildApkFastDev;_CreateBaseApk;ProcessNativeLibraries">
    <ItemGroup>
      <_CircleAIGlibcNative Include="@(ResolvedFileToPublish)"
                            Condition="$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-')) And !$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-bionic'))" />
      <ResolvedFileToPublish Remove="@(_CircleAIGlibcNative)" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-')) And !$([System.String]::Copy('%(Identity)').Contains('/runtimes/linux-bionic'))" />
    </ItemGroup>
    <Message Importance="high"
             Condition="'@(_CircleAIGlibcNative)' != ''"
             Text="[CircleAI] Dropped @(_CircleAIGlibcNative->Count()) glibc native(s) that the RID graph offered to this Android build." />
  </Target>

</Project>
