<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Banking</PackageId>
    <Version>3.0.0</Version>
    <Description>(2.8.0) Banking contract surface — drives the AI when it operates inside a banking stack. IAccountReader (OBP-API pattern), ILedgerWriter (fineract pattern), IPaymentProcessor (hyperswitch pattern). Null impls fail-closed. Real backends 2.8.1.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;banking;obp;fineract;hyperswitch</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
