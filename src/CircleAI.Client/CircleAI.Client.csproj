<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Client</PackageId>
    <Description>
      Client for a host app to use CircleAI's shared on-device brain. Detects the
      installed standalone service, binds it, and asks a turn over the authorized
      cross-app link — the person approves the link once with device auth, and from
      then the app calls the one shared brain instead of shipping its own model.
      A host app must declare a &lt;queries&gt; entry for the CircleAI package
      (Android 11+ package visibility) to see and bind the service.
    </Description>
  
    <!--
      NO ENGINE NATIVES. The repo-root Directory.Build.targets bundles MNN and
      Whisper into EVERY android project - both default to true - and this is an
      android class library, so they landed in CircleAI.Client.aar and the app
      unpacked them from there. That is how a client whose whole purpose is to
      NOT hold a model shipped libMNN.so, libllm.so, libmnnbridge.so and five
      whisper/ggml libraries: no project reference named them, no csproj named
      them, and the only place it showed was a listing of the APK.

      The service still gets both - samples/CircleAIService is an android app and
      does not opt out - next to the models that use them.
    -->
    <CircleAIBundleMnn>false</CircleAIBundleMnn>
    <CircleAIBundleWhisper>false</CircleAIBundleWhisper>
</PropertyGroup>

  <!-- Plain Android head, not MAUI: any Android app (ours or third-party) can
       reference this without taking the MAUI stack. Singular android TFM, so the
       net9 guardrail treats it as a head, not a library. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <!-- AndroidAudio.cs and its siblings are guarded by this, as in every project that
         compiles them - without it the file compiles to nothing and AndroidAudioCapture
         reads as a missing NAMESPACE rather than a missing definition. -->
    <DefineConstants>$(DefineConstants);IT_VOICE_ANDROID</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- AUDIO, NOT THE VOICE STACK. The microphone, the speaker, the sample format and
         the level-based VAD - AudioFormat, IAudioCapture, IAudioPlayer, IAudioDecoder,
         WavIo - with no Whisper and no ONNX voices behind them. Those are the
         service's, and taking CircleAI.Voice here would put 18.3 MB of
         libonnxruntime.so into every client that opens a microphone. -->
    <ProjectReference Include="..\CircleAI.Audio\CircleAI.Audio.csproj" />
    <ProjectReference Include="..\CircleAI.Linking\CircleAI.Linking.csproj" />
    <!-- IBrain, so a client can drop in LinkedBrain where it had a local one.
         CircleAI.Assistant is the contracts assembly and keeps its own reference
         count near zero, so this adds contracts and not an engine. -->
    <ProjectReference Include="..\CircleAI.Assistant\CircleAI.Assistant.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQLite for SqliteAppStore. THE ONE FILE FOR ALL OF A HEAD'S STATE, and both
         halves need it: the app for its settings, the service to find its own storage.
         Declared here rather than inherited, because it arrived behind an unrelated
         reference once and removing that reference broke the settings store. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
