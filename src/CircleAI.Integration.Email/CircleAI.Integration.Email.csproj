<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Integration.Email</PackageId>
    <Version>3.3.0</Version>
    <Description>Email integrations for Circle AI — Gmail API, Microsoft Graph (Outlook mail), and generic IMAP via MailKit.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Integration\CircleAI.Integration.csproj" />
    <PackageReference Include="MailKit" Version="4.7.1.1" />
  </ItemGroup>
</Project>
