<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Hosting.InferenceBridge</PackageId>
    <Version>1.3.0</Version><Description>Cross-OS LLM inference daemon contract for Circle AI — one model loaded once per device, shared by every app via OS-specific IPC. 1.3.0 adds InferenceResponse.ReasoningText, IInferenceBridge.StreamFragmentsAsync, and InferenceFragment / InferenceFragmentKind so callers can route reasoning models' &lt;think&gt;…&lt;/think&gt; into a separate reasoning_content field (DeepSeek-R1 / o1 style). Backward-compatible — every new method has a default impl that wraps the existing stream as Content-only.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Inference\CircleAI.Inference.csproj" />
    <!-- Real device-capability probe + backend selector + native runtime
         fetcher. LocalProcessInferenceBridge defaults to a new
         CapabilityProbe() when no ICapabilityProbe is supplied — replaces
         the synthetic GetDeviceCapabilitiesAsync stub. -->
    <ProjectReference Include="..\CircleAI.Runtime\CircleAI.Runtime.csproj" />
  </ItemGroup>

</Project>
