<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Hosting.InferenceBridge</PackageId>
    <Version>2.0.0</Version><Description>Cross-OS LLM inference daemon contract for Circle AI. 2.0.0 picks up CircleAI.Inference 2.0.0 — the fallback chain / brownout release. Bridge surface unchanged; behaviour benefits transparently through the underlying generator.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Inference\CircleAI.Inference.csproj" />
    <!-- Real device-capability probe + backend selector + native runtime
         fetcher. LocalProcessInferenceBridge defaults to a new
         CapabilityProbe() when no ICapabilityProbe is supplied — replaces
         the synthetic GetDeviceCapabilitiesAsync stub. -->
    <ProjectReference Include="..\CircleAI.Runtime\CircleAI.Runtime.csproj" />
  </ItemGroup>

</Project>
