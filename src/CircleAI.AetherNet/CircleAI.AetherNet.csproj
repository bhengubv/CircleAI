<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.AetherNet</PackageId>
    <Description>
      The runtime adapter that bridges CircleAI.Aether contracts to the live
      AetherNet protocol. 2.0.1 adds (RT-12 v1) MeshCapabilityAdvertisement +
      IMeshCapabilityRegistry + InMemoryMeshCapabilityRegistry +
      IMeshCapabilityBroadcaster + NullMeshCapabilityBroadcaster. Peers
      publish loaded-model availability ("Qwen3-1.7B with 2048 free KV tokens
      on a Phone tier"); registry queries by model + min-free-KV + staleness.
      Contracts only; AetherNet transport binding lands with v2 actual
      offload in 2.7.0. Also: IAetherContext, IAetherTelemetry,
      ISecurityDirectiveConsumer (unchanged from 1.1.0).

      Floats AetherNet.* with Version="2.*" so patch/minor upstream releases
      flow through to consumers without re-pin. Version aligned with 2.0.1
      SDK bundle.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Aether\CircleAI.Aether.csproj" />
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
    <!-- INetworkTransport / NetworkPayload — this project provides an AetherNet-backed
         carrier (AetherMeshTransport). CircleAI.Networking is package-free. -->
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
  </ItemGroup>

  <!-- Floating refs — track 2.x upstream automatically. -->
  <ItemGroup>
    <!-- EXACT, NOT "3.*". A floating range lets an upstream release change what
         this assembly does with no commit here, and the first anyone would know
         is a device behaving differently. 3.0.0 is the latest published on
         nuget.org (2.0.0 -> 2.5.0 -> 3.0.0). -->
    <PackageReference Include="AetherNet.Core"      Version="3.0.0" />
    <PackageReference Include="AetherNet.Transport" Version="3.0.0" />
    <PackageReference Include="AetherNet.Security"  Version="3.0.0" />
    <PackageReference Include="AetherNet.Messaging" Version="3.0.0" />
    <!-- Microsoft.Extensions.* come transitively via AetherNet.Core 1.1.0
         (10.0.2). No need to declare them here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
