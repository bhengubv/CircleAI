<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.AetherNet</PackageId>
    <Version>2.3.0</Version>
    <Description>
      The runtime adapter that bridges CircleAI.Aether contracts to the live
      AetherNet protocol. 2.0.1 adds (RT-12 v1) MeshCapabilityAdvertisement +
      IMeshCapabilityRegistry + InMemoryMeshCapabilityRegistry +
      IMeshCapabilityBroadcaster + NullMeshCapabilityBroadcaster. Peers
      publish loaded-model availability ("Qwen3-1.7B with 2048 free KV tokens
      on a Phone tier"); registry queries by model + min-free-KV + staleness.
      Contracts only; AetherNet transport binding lands with v2 actual
      offload in 2.7.0. Also: IAetherContext, IAetherTelemetry,
      ISecurityDirectiveConsumer (unchanged from 1.1.0).

      Floats AetherNet.* with Version="1.*" so patch/minor upstream releases
      flow through to consumers without re-pin. Version aligned with 2.0.1
      SDK bundle.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Aether\CircleAI.Aether.csproj" />
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>

  <!-- Floating refs — track 1.x upstream automatically. -->
  <ItemGroup>
    <PackageReference Include="AetherNet.Core"      Version="1.*" />
    <PackageReference Include="AetherNet.Transport" Version="1.*" />
    <PackageReference Include="AetherNet.Security"  Version="1.*" />
    <PackageReference Include="AetherNet.Messaging" Version="1.*" />
    <!-- Microsoft.Extensions.* come transitively via AetherNet.Core 1.1.0
         (10.0.2). No need to declare them here. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.*" />
  </ItemGroup>

</Project>
