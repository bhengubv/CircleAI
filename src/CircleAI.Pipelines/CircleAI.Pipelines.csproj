<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Pipelines</PackageId>
    <Version>3.1.0</Version>
    <Description>(3.0.1) Data-pipeline contract surface — etl + airbyte + mysql-mcp + postgres-mcp patterns. IPipelineSource, IPipelineSink, IPipelineExecutor, IDatabaseQueryTool. Null impls degrade gracefully.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;pipelines;etl;airbyte;mcp</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
