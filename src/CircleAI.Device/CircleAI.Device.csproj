<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Device</PackageId>
    <Description>Android hosting for Circle AI: the resident device service that owns the models, and the memory probe every Android head must install.</Description>
  </PropertyGroup>

  <!-- Plain Android, NOT MAUI. The MAUI hosting lives in CircleAI.Maui and pulls
       the whole MAUI stack with it; an app that just wants the device service
       should not have to take that. The sample app is a bare Android app and is
       this library's first consumer, which keeps the dependency honest. -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsBindingProject>false</IsBindingProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Hosting\CircleAI.Hosting.csproj" />
    <!-- The cross-app link door (CircleNeuronLinkService) authorizes callers by
         the link grant policy and the biometric/PIN gate contract. -->
    <ProjectReference Include="..\CircleAI.Linking\CircleAI.Linking.csproj" />
    <ProjectReference Include="..\CircleAI.Aether\CircleAI.Aether.csproj" />
    <!-- The link's memory / skills / discovery verbs serve these directly:
         the person's memory, the built-in skill pack, the capability manifest. -->
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
    <ProjectReference Include="..\CircleAI.Skills\CircleAI.Skills.csproj" />
  </ItemGroup>

</Project>
