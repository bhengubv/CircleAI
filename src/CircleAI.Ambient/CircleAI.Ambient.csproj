<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Ambient</PackageId>
    <Description>Circle AI surface adapter for always-on ambient devices (smart speakers,
room displays, car infotainment). Low-power background monitor with
proactive trigger evaluation and voice-first output.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Companion\CircleAI.Companion.csproj" />
  </ItemGroup>
</Project>
