<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Research</PackageId>
    <Version>3.0.0</Version>
    <Description>(3.0.0) Research corpora contract surface — the_well + UnifiedFieldTheory + arxiv ingestion. IResearchCorpus + IPaperRetrieval + ICitationGraph. Lets a host build a domain-specific research assistant.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;research;papers;arxiv</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
