<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Federation</PackageId>
    <Description>Federated learning round model for Circle AI — only deltas leave the device, never raw data. Designed for mesh-based aggregation over Aether transport.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CIRCLEAI_FED_001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Security\CircleAI.Security.csproj" />
  </ItemGroup>

</Project>
