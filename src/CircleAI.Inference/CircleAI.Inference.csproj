<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Inference</PackageId>
    <Version>1.3.5</Version><Description>On-device LLM inference for Circle. Alibaba MNN P/Invoke layer with Qwen 3 chat generator. 1.3.5 adds android-arm (32-bit ARMv7) + ios-arm64 (static .a). 7 RIDs total: win-x64, linux-x64, osx-arm64, osx-x64, android-arm64, android-arm, ios-arm64. android-arm: libmnnbridge.so (1.2 MB ELF 32-bit ARM EABI5) + full companion .so set from Alibaba's armeabi-v7a Android MNN. ios-arm64: libmnnbridge.a (34 KB ar archive) + libMNN.a (10 MB, copied from Static/MNN.framework/MNN) — iOS prohibits dynamic library loading from the app sandbox, so the bridge ships as a static library for link-time integration via NativeReference in the consuming MAUI app. CMakeLists.txt iOS branch now respects BUILD_SHARED_LIBS=OFF + uses Static/MNN.framework (with flat Headers/) instead of Dynamic/MNN.framework/Versions/A/Headers. 1.3.4 added osx-x64 + android-arm64 + macOS codesigning.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
	</ItemGroup>

	<!-- Native runtime payload. The SDK's default item glob excludes
	     runtimes/** from auto-pack, so we explicitly add anything under
	     runtimes/{RID}/native/ to the package at the matching path AND
	     copy it to the consumer's bin/{tfm}/runtimes/{RID}/native/ at
	     build time. The Pack="true" path covers NuGet consumers; the
	     CopyToOutputDirectory + Link path covers ProjectReference
	     consumers (CircleAI.Inference.Server, CircleAI.Maui, tests)
	     which otherwise get an empty runtimes folder.
	     Currently: win-x64 mnnbridge.dll + MNN.dll ship. Future platforms:
	     build mnnbridge per BUILD.md, drop the .so/.dylib into the matching
	     runtimes/{RID}/native/ folder, re-pack. -->
	<ItemGroup>
		<None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/">
			<Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<!-- Disable RID-specific asset warnings -->
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>

		<!-- Native MNN libs (mnnbridge + MNN) live under runtimes/{RID}/native/.
		     Windows x64 ships in the package out of the box. Other RIDs are
		     built per native/mnn-bridge/BUILD.md and added to the same folder
		     before publish. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<!-- Native library bundling — copies mnnbridge + MNN binaries for the
	     current platform. Override $(CircleAINativeLibRoot) to point at your
	     own directory if you've built mnnbridge for another RID. -->
	<Import Project="$(MSBuildThisFileDirectory)CircleAI.Inference.targets" />

</Project>
