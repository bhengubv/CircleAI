<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Inference</PackageId>
    <Version>1.2.1</Version><Description>On-device LLM inference for Circle. Alibaba MNN P/Invoke layer with Qwen 3 chat generator. 1.2.1 ships the Windows x64 mnnbridge.dll + MNN.dll under runtimes/win-x64/native/ — first version that actually runs inference end-to-end on Windows. Other platforms: build mnnbridge from native/mnn-bridge/ per BUILD.md.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Disable RID-specific asset warnings -->
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>

		<!-- Native MNN libs (mnnbridge + MNN) live under runtimes/{RID}/native/.
		     Windows x64 ships in the package out of the box. Other RIDs are
		     built per native/mnn-bridge/BUILD.md and added to the same folder
		     before publish. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<!-- Native library bundling — copies mnnbridge + MNN binaries for the
	     current platform. Override $(CircleAINativeLibRoot) to point at your
	     own directory if you've built mnnbridge for another RID. -->
	<Import Project="$(MSBuildThisFileDirectory)CircleAI.Inference.targets" />

</Project>
