<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Inference</PackageId>
    <Version>1.6.0</Version><Description>On-device LLM inference for Circle. 1.6.0 fixes the MNN P/Invoke ABI (mnn_llm_generate_ex / _stream_ex / _with_image_stream_ex were declared with phantom sampling params and a wrong-shape token callback — the param-count mismatch crashed the bridge with 0xC0000005 on the first emitted token; rebound to the real 5/6-arg signatures from mnnbridge.h with an [UnmanagedCallersOnly] int(int,IntPtr) callback). Also: per-handle SemaphoreSlim serialisation (mnnbridge.h declares concurrent calls UB), mnn_llm_reset_session before every generation (stateless multi-turn), and a &lt;think&gt;…&lt;/think&gt; → reasoning_content router so Qwen3 / DeepSeek-R1 / o1-style reasoning surfaces as a separate ChatResponse field (new ChatResponse.ReasoningContent, ChatFragment, ChatFragmentKind, GenerationOptions.IncludeReasoning, IChatGenerator.StreamFragmentsAsync). Carries forward 1.5.0's installed.json upgrade-detection and 1.4.1's TurboQuant KV-cache compression. mnnbridge 1.2.0 native payload unchanged — 8 RIDs (win-x64, linux-x64, linux-arm64, osx-arm64, osx-x64, android-arm64, android-arm, ios-arm64).</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>

		<!-- CA1420 (runtime-marshalling required) becomes an error so a future
		     edit to MnnInterop's delegates/P-Invokes cannot reintroduce the
		     [DisableRuntimeMarshalling] fatal-stack-corruption bug that
		     manifested as a 0xC0000005 on the first streamed token. -->
		<WarningsAsErrors>$(WarningsAsErrors);CA1420</WarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
	</ItemGroup>

	<!-- Jinja2-compatible template engine for catalog-driven chat_template
	     rendering. Each model on ModelScope ships its own chat_template
	     in tokenizer_config.json; PromptTemplateEngine renders messages
	     through it so the SDK never hardcodes ChatML format. Scriban is
	     the fastest .NET Jinja2-compatible renderer (Sandcastle's
	     benchmark). Pure managed, no native deps. -->
	<ItemGroup>
		<PackageReference Include="Scriban" Version="7.2.4" />
	</ItemGroup>

	<!-- Native runtime payload. The SDK's default item glob excludes
	     runtimes/** from auto-pack, so we explicitly add anything under
	     runtimes/{RID}/native/ to the package at the matching path AND
	     copy it to the consumer's bin/{tfm}/runtimes/{RID}/native/ at
	     build time. The Pack="true" path covers NuGet consumers; the
	     CopyToOutputDirectory + Link path covers ProjectReference
	     consumers (CircleAI.Inference.Server, CircleAI.Maui, tests)
	     which otherwise get an empty runtimes folder.
	     Currently: win-x64 mnnbridge.dll + MNN.dll ship. Future platforms:
	     build mnnbridge per BUILD.md, drop the .so/.dylib into the matching
	     runtimes/{RID}/native/ folder, re-pack. -->
	<ItemGroup>
		<None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/">
			<Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<!-- Disable RID-specific asset warnings -->
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>

		<!-- Native MNN libs (mnnbridge + MNN) live under runtimes/{RID}/native/.
		     Windows x64 ships in the package out of the box. Other RIDs are
		     built per native/mnn-bridge/BUILD.md and added to the same folder
		     before publish. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<!-- Native library bundling — copies mnnbridge + MNN binaries for the
	     current platform. Override $(CircleAINativeLibRoot) to point at your
	     own directory if you've built mnnbridge for another RID. -->
	<Import Project="$(MSBuildThisFileDirectory)CircleAI.Inference.targets" />

</Project>
