<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Inference</PackageId>
    <Version>1.3.0</Version><Description>On-device LLM inference for Circle. Alibaba MNN P/Invoke layer with Qwen 3 chat generator. 1.3.0 adds ModelDownloadService.EnsureBundleAsync — the multi-file MNN bundle downloader that fetches every file MNN-LLM needs (config.json, llm.mnn, llm.mnn.weight, tokenizer.txt, llm_config.json, configuration.json) into a per-model directory with Primary→Fallback URL fallback per file, atomic temp→move, cache reuse via SHA verify, and per-file SHA-256 verification. MnnInferenceBridgeFactory now routes bundle entries through EnsureBundleAsync and points QwenTextGenerator at the bundle's config.json. IModelDownloadService gains EnsureBundleAsync(modelId, repo, bundleFiles, progress, ct) + BundleFileSpec record. 1.2.3 fixed the SHA-256 "sha256:" prefix-strip bug + set a realistic User-Agent.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
	</ItemGroup>

	<!-- Native runtime payload. The SDK's default item glob excludes
	     runtimes/** from auto-pack, so we explicitly add anything under
	     runtimes/{RID}/native/ to the package at the matching path.
	     Currently: win-x64. Future platforms: build mnnbridge per BUILD.md,
	     drop the .so/.dylib into the matching runtimes/{RID}/native/
	     folder, re-pack. -->
	<ItemGroup>
		<None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/" />
	</ItemGroup>

	<PropertyGroup>
		<!-- Disable RID-specific asset warnings -->
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>

		<!-- Native MNN libs (mnnbridge + MNN) live under runtimes/{RID}/native/.
		     Windows x64 ships in the package out of the box. Other RIDs are
		     built per native/mnn-bridge/BUILD.md and added to the same folder
		     before publish. -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

	<!-- Native library bundling — copies mnnbridge + MNN binaries for the
	     current platform. Override $(CircleAINativeLibRoot) to point at your
	     own directory if you've built mnnbridge for another RID. -->
	<Import Project="$(MSBuildThisFileDirectory)CircleAI.Inference.targets" />

</Project>
