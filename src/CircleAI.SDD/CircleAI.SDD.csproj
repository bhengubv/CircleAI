<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.SDD</PackageId>
    <Version>3.3.0</Version>
    <Description>(3.0.1) Spec-Driven Development contracts — github/spec-kit pattern-port. ISpecificationStore + ISpecificationValidator + ISpecToScaffold codegen hook. Lets a host hand the AI a spec document and get a compilable scaffold back. Null impls degrade to no-op. Real backends in 2.7.1.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;sdd;spec-kit;codegen;scaffolding</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
