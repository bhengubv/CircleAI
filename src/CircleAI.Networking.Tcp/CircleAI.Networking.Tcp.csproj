<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Networking.Tcp</PackageId>
    <Version>1.2.0</Version>
    <Description>Raw TCP and UDP transports for Circle AI Networking. Low-level when needed.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
  </ItemGroup>
</Project>
