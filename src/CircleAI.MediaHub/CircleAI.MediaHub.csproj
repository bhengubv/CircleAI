<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.MediaHub</PackageId>
    <Version>3.1.0</Version>
    <Description>(3.0.1) Media-serving contracts — pms-docker-plex + beatsync patterns. IMediaLibrary + ISyncedPlayback. Renamed from CircleAI.MediaServer 3.0.0 — that package ID exists on nuget.org but is a dead-end; nothing newer will ship under that ID. New consumers: `dotnet add package CircleAI.MediaHub`.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;media-hub;plex;beatsync</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
