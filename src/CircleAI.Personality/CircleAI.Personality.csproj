<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Personality</PackageId>
    <Description>User-declared persona artefact — structured identity declaration the user owns, edits, and exports. Complements CircleAI.Memory.PersonaState (AI's learned model of the user).</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core interfaces (IDeviceContext, etc.) -->
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <!-- PersonaState lives here — Persona declares bounds, PersonaState is the learned interior. -->
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>
</Project>
