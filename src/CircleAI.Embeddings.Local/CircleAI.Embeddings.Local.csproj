<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Embeddings.Local</PackageId>
    <Version>2.0.3</Version>
    <Description>(RT-09) On-device embedding store with built-in RAG primitive for CircleAI. 2.0.2 is a no-API-change refresh aligned with the 2.0.2 bundle. Carries forward 2.0.1's macOS turbovec dylibs (osx-arm64 + osx-x64) alongside win-x64 — 3 of 8 RIDs. Linux/Android/iOS queued for 2.1.0.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;llm;circle-ai;embeddings;rag;turboquant;on-device</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

  <!-- Native turbovecbridge cdylib for the RT-09b HNSW backend. Same
       pattern as CircleAI.Inference: anything under runtimes/{RID}/native/
       gets packed at the matching package path AND copied to the
       consumer's bin/{tfm}/runtimes/{RID}/native/ at build time. -->
  <ItemGroup>
    <None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/">
      <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
  </PropertyGroup>

</Project>
