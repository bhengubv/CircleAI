<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Embeddings.Local</PackageId>
    <Version>2.0.0</Version>
    <Description>(RT-09) On-device embedding store with built-in RAG primitive for CircleAI. Bring your own encoder via IEmbeddingEncoder (or wire your favourite sentence-transformer); the store handles add/search/persist. Vectors are TurboQuant-compressed at 4-bits-per-dim (~8× shrink vs FP32) so a phone can hold ~250K paragraphs in 1 GB. Brute-force cosine for v1; HNSW upgrade in 2.1.0. SemVer-pinned to CircleAI.Core 2.0.0.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;llm;circle-ai;embeddings;rag;turboquant;on-device</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

  <!-- Native turbovecbridge cdylib for the RT-09b HNSW backend. Same
       pattern as CircleAI.Inference: anything under runtimes/{RID}/native/
       gets packed at the matching package path AND copied to the
       consumer's bin/{tfm}/runtimes/{RID}/native/ at build time. -->
  <ItemGroup>
    <None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/">
      <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
  </PropertyGroup>

</Project>
