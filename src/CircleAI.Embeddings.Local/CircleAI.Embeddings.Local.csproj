<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Embeddings.Local</PackageId>
    <Version>2.0.1</Version>
    <Description>(RT-09) On-device embedding store with built-in RAG primitive for CircleAI. 2.0.1 adds the macOS native dylibs for the turbovec HNSW backend (osx-arm64 + osx-x64) alongside the existing win-x64 — IEmbeddingIndex plug point + TurboVecEmbeddingIndex + HnswEmbeddingStore now work on 3 of 8 RIDs. Brute-force InMemoryEmbeddingStore unchanged. Linux/Android/iOS cross-builds queued for 2.1.0.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;llm;circle-ai;embeddings;rag;turboquant;on-device</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

  <!-- Native turbovecbridge cdylib for the RT-09b HNSW backend. Same
       pattern as CircleAI.Inference: anything under runtimes/{RID}/native/
       gets packed at the matching package path AND copied to the
       consumer's bin/{tfm}/runtimes/{RID}/native/ at build time. -->
  <ItemGroup>
    <None Include="runtimes/**/*.*" Pack="true" PackagePath="runtimes/">
      <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
  </PropertyGroup>

</Project>
