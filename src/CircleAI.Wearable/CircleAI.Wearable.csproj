<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Wearable</PackageId>
    <Description>Circle AI surface adapter for smartwatches and wearable devices.
Injects biometric context (heart rate, steps, SpO₂) into the Companion session
and enforces wearable-appropriate reply constraints.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Companion\CircleAI.Companion.csproj" />
  </ItemGroup>
</Project>
