<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Workflows</PackageId>
    <Version>2.8.0</Version>
    <Description>(2.8.0) Durable workflow contracts — restate + automatisch + paca patterns. IWorkflowDefinition + IWorkflowRunner + IWorkflowState (durable checkpoint store).</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;workflows;restate;automatisch;paca;durable</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
