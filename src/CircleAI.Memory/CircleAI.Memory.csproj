<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Memory</PackageId>
    <Version>1.2.0</Version><Description>On-device episodic memory, affect state, and context window management for Circle AI agents.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<!-- Core interfaces (IDeviceContext, IModelManager, etc.) -->
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
		<!-- ITextEmbedder lives in the Embeddings namespace (Core project) -->
		<ProjectReference Include="..\CircleAI.Embeddings\CircleAI.Embeddings.csproj" />
		<!-- VectorMath for cosine-similarity retrieval -->
		<ProjectReference Include="..\CircleAI.Search\CircleAI.Search.csproj" />
	</ItemGroup>
</Project>
