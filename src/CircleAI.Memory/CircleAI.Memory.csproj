<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Memory</PackageId>
    <Version>1.4.0</Version><Description>On-device episodic + multimodal memory, affect state, context window management, hierarchical sleep-cycle consolidation, TurboQuant compression, cross-device sync, and the CompanionRuntime orchestrator for Circle AI agents.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>
	<ItemGroup>
		<!-- 10.0.11 pulls SQLitePCLRaw lib.e_sqlite3 2.1.12, one past the
		     GHSA-2m69-gcr7-jv3q affected range (<= 2.1.11). -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	</ItemGroup>
	<ItemGroup>
		<!-- Core interfaces (IDeviceContext, IModelManager, etc.) -->
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
		<!-- ITextEmbedder lives in the Embeddings namespace (Core project) -->
		<ProjectReference Include="..\CircleAI.Embeddings\CircleAI.Embeddings.csproj" />
		<!-- VectorMath for cosine-similarity retrieval -->
		<ProjectReference Include="..\CircleAI.Search\CircleAI.Search.csproj" />
	</ItemGroup>
</Project>
