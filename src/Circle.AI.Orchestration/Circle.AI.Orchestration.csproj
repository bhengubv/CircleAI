<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>Circle.AI.Orchestration</PackageId>
    <Description>Host-side loki-mode agent orchestration layer for Circle AI — spawns Engineering, Operations, and Review agent swarms, routes incident triggers, and enforces quality gates before deployment.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core interfaces (IDeviceContext, IModelManager, etc.) -->
    <ProjectReference Include="..\Circle.AI.Core\Circle.AI.Core.csproj" />
    <!-- EpisodicMemoryEntry, AffectState -->
    <ProjectReference Include="..\Circle.AI.Memory\Circle.AI.Memory.csproj" />
  </ItemGroup>

</Project>
