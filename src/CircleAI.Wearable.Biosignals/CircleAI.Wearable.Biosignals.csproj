<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Wearable.Biosignals</PackageId>
    <Description>Biosignal ingestion (HR, HRV, SpO2, accelerometer, etc.) and projection into CircleAI.Memory.AffectState — the sensor layer of personal AI.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
  </ItemGroup>

</Project>
