<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Networking.Mqtt</PackageId>
    <Description>MQTT transport for Circle AI Networking. Pub/sub, QoS 0/1/2, retain — ideal for IoT sensors.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
    <PackageReference Include="MQTTnet" Version="4.3.6.1152" />
  </ItemGroup>
</Project>
