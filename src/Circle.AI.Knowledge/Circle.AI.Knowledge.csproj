<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>Circle.AI.Knowledge</PackageId>
    <Description>Markdown-on-disk knowledge store for Circle AI — episodic memory as user-editable .md files with YAML frontmatter. Git-diffable, exportable, user-owned.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Circle.AI.Core\Circle.AI.Core.csproj" />
    <!-- IEpisodicMemoryStore + EpisodicMemoryEntry live here. -->
    <ProjectReference Include="..\Circle.AI.Memory\Circle.AI.Memory.csproj" />
  </ItemGroup>
</Project>
