<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.CodeUnderstanding</PackageId>
    <Version>3.0.1</Version>
    <Description>(3.0.1) Code-understanding contract surface — Understand-Anything pattern. ICodeIndexer + ICodeSearch + ISymbolGraph. Cornerstone of the "drop CircleAI in to replace Claude Code / Codex / Cursor" pitch.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;code;ast;symbols;ide</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
