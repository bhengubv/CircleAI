<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Security.Aether</PackageId>
    <Version>1.3.0</Version>
    <Description>
      Aether mesh bridge for CircleAI.Security. Translates mesh telemetry events
      into transport-agnostic PeerSecurityEvents and adapts the transport-agnostic
      intelligence output to implement CircleAI.Aether's IAetherIntelligence and
      IAISecurityLayer. Contracts-only — no external Aether runtime dependency.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Security\CircleAI.Security.csproj" />
    <ProjectReference Include="..\CircleAI.Aether\CircleAI.Aether.csproj" />
  </ItemGroup>

</Project>
