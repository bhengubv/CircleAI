<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.CRM</PackageId>
    <Version>3.0.1</Version>
    <Description>(3.0.1) CRM contract surface — twenty pattern-port. IContactStore + IDealPipeline + IActivityLog. Null impls fail-closed (no data persisted).</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;crm;twenty;contacts;deals</PackageTags>
