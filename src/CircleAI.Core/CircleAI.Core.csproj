<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Core</PackageId>
    <Version>2.0.0</Version><Description>On-device AI core for Circle — 2.0.0 ships the managed-side of the "cheap-phone tier" runtime program. ModelEntry gains FallbackModelId (RT-08 chain-head) and MemoryHintBytes (RT-04 brownout sizing); the embedded registry stamps both across Qwen3 (14B→8B→4B→1.7B→0.6B) and Qwen2.5 (7B→3B→1.5B→0.5B) families. Carries forward 1.5.0's upgrade-detection plumbing and 1.4.0's catalog-driven foundations.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Legacy file kept for callers that load it by name; the canonical resource
		     consumed by ModelRegistryService is Models\embedded_registry.json. -->
		<EmbeddedResource Include="registry.json" />
		<EmbeddedResource Include="Models\embedded_registry.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- 1.1.0 — CircleAIComponentBase + LoggerAuditLog need ILogger.
		     Abstractions-only so consumers choose their own logging backend. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>
</Project>
