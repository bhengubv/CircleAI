<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Core</PackageId>
    <Version>1.5.0</Version><Description>On-device AI core for Circle. 1.5.0 adds upgrade-detection: UpgradeInfo record + UpgradeReason enum (VersionChanged / SHAChanged / Both / Unknown) + InstalledManifest record. ModelRegistryService.CheckForUpgradesAsync(storageDirectory) walks every installed model, compares the on-disk installed.json against the active registry (Version string + per-file SHA), and returns one UpgradeInfo per detected drift. Hosts subscribe via IAIObserver.OnUpgradeAvailableAsync — the SDK never auto-applies. Carries forward 1.4.0's catalog-driven SDK foundations: ModelScopeCatalogClient, signature verifier, DeviceProbe + DefaultDeviceContext, DeviceTierDefaults, capability + RAM + storage ranking on ModelEntry.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Legacy file kept for callers that load it by name; the canonical resource
		     consumed by ModelRegistryService is Models\embedded_registry.json. -->
		<EmbeddedResource Include="registry.json" />
		<EmbeddedResource Include="Models\embedded_registry.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- 1.1.0 — CircleAIComponentBase + LoggerAuditLog need ILogger.
		     Abstractions-only so consumers choose their own logging backend. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>
</Project>
