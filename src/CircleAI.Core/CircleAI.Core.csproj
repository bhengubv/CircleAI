<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Core</PackageId>
    <Version>2.0.3</Version><Description>On-device AI core for Circle — 2.0.2 is a no-API-change refresh aligned with the 2.0.2 SDK bundle (skill-pack auto-import). Carries forward 2.0.0's RT-08 fallback chain stamping and RT-04 brownout sizing on ModelEntry.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Legacy file kept for callers that load it by name; the canonical resource
		     consumed by ModelRegistryService is Models\embedded_registry.json. -->
		<EmbeddedResource Include="registry.json" />
		<EmbeddedResource Include="Models\embedded_registry.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- 1.1.0 — CircleAIComponentBase + LoggerAuditLog need ILogger.
		     Abstractions-only so consumers choose their own logging backend. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>
</Project>
