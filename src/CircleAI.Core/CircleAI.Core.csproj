<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Core</PackageId>
    <Version>1.4.0</Version><Description>On-device AI core for Circle. 1.4.0 ships the P0 atomic shift — catalog-driven, device-inferred SDK. New: ModelScopeCatalogClient (live ModelScope catalog with disk cache, OnStartup/Daily/Manual/Never cadence, connectivity gate skips HTTPS when host reports offline), ICatalogSignatureVerifier (fail-closed NullCatalogSignatureVerifier default), DeviceProbe + DefaultDeviceContext (moved into Core — RAM/storage/CPU/GPU/thermal/connectivity snapshot with Wearable/Phone/Tablet/Desktop/Workstation tier classification), DeviceTierDefaults (ContextWindow 2K-131K, MaxConcurrency 1-min(16,cores-2), AgenticMaxIterations 2-10 per tier). ModelRegistryService primes from catalog client when supplied; AllModels is now virtual. ModelEntry adds MinRamGb, MinStorageGb, Capabilities[], QualityRank for device-fit ranking.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<!-- Legacy file kept for callers that load it by name; the canonical resource
		     consumed by ModelRegistryService is Models\embedded_registry.json. -->
		<EmbeddedResource Include="registry.json" />
		<EmbeddedResource Include="Models\embedded_registry.json" />
	</ItemGroup>

	<ItemGroup>
		<!-- 1.1.0 — CircleAIComponentBase + LoggerAuditLog need ILogger.
		     Abstractions-only so consumers choose their own logging backend. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>
</Project>
