<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Networking.Aether</PackageId>
    <Version>1.2.0</Version>
    <Description>Aether mesh implementation of CircleAI.Networking. Signal E2E, AODV routing, DTN store-and-forward, SOS flood. Wraps aether-protocol engine.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
    <ProjectReference Include="..\CircleAI.Aether\CircleAI.Aether.csproj" />
  </ItemGroup>
</Project>
