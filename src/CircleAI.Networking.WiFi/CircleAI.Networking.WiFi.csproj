<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Networking.WiFi</PackageId>
    <Version>1.2.0</Version>
    <Description>WiFi Direct / mDNS / LAN transport for Circle AI. No Aether required. Peer discovery via UDP broadcast and mDNS.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
  </ItemGroup>
</Project>
