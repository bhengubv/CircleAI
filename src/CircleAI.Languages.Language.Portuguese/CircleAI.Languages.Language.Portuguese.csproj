<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Languages.Language.Portuguese</PackageId>
    <Version>1.2.0</Version>
    <Description>Portuguese language pack for Circle AI. Idiomatic expressions, cultural context, and locale-specific prompt tuning for PT,BR,MZ,AO.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Languages.Language\CircleAI.Languages.Language.csproj" />
  </ItemGroup>
</Project>
