<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Aether</PackageId>
    <Version>1.3.0</Version>
    <Description>
      Aether mesh contracts for CircleAI — pure abstractions, no external runtime
      dependency. Defines IAetherContext, IAetherIntelligence, IAetherTelemetry,
      IAISecurityLayer, IAuthChallenge and supporting event types. Implementations
      ship in separate adapter packages (e.g. CircleAI.Aether.AetherMesh) that
      float their AetherMesh version constraint — this package never tethers
      consumers to a specific Aether protocol version.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    NO external dependencies. This is a pure contracts package.
    To wire a real mesh implementation, install an adapter:
        dotnet add package CircleAI.Aether.AetherMesh
    Adapters float their AetherMesh.* version with Version="1.*" so they pick
    up upstream patch/minor releases without consumers needing to re-pin.
  -->

</Project>
