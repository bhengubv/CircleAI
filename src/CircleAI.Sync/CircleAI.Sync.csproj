<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Sync</PackageId>
    <Description>Memory delta sync for Circle AI. Episodic memory, affect state, and persona deltas propagate across all devices via any transport (gRPC, mesh, DTN). This is the cross-device continuity layer.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Identity\CircleAI.Identity.csproj" />
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
    <ProjectReference Include="..\CircleAI.Networking\CircleAI.Networking.csproj" />
  </ItemGroup>
</Project>
