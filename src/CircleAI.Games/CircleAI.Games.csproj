<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Games</PackageId>
    <Version>3.1.0</Version>
    <Description>(3.0.1) Game-runtime contracts — flame + Doom.Mobile patterns. IGameLoop + IInputMap + ISceneGraph. Lets a host wire CircleAI into a game-engine event loop for NPC dialog / dynamic content / co-pilot play.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;games;flame;doom</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
