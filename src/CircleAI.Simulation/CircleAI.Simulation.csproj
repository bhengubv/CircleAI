<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Simulation</PackageId>
    <Description>GraphRAG/MiroFish simulation layer for Circle AI — builds knowledge graphs from episodic memory, runs offline network health forecasts.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Episodic memory types (EpisodicMemoryEntry) -->
    <ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
    <!-- Core interfaces (IDeviceContext, IModelManager, etc.) -->
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <!-- AnomalySignal, ThreatVector — used by ThreatPropagationScenario factory -->
    <ProjectReference Include="..\CircleAI.Security\CircleAI.Security.csproj" />
  </ItemGroup>

</Project>
