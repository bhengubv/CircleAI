<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Voice</PackageId>
    <Description>TTS/STT abstraction layer for Circle AI voice interaction.</Description>
  </PropertyGroup>

	<PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE ENGINE-FREE HALF. Sample formats, the microphone and speaker contracts,
         WAV, level-based VAD, transcripts, subtitles. Split out so a client can
         capture and play audio without this project's Microsoft.ML.OnnxRuntime and
         Whisper.net.Runtime - which are NuGet native assets and therefore not
         optional for whoever references this assembly.

         The namespace is still CircleAI.Voice on both sides, so nothing downstream
         changed. This direction is the one that works: reversed, every consumer of
         the small half would still drag the engines in behind it. -->
    <ProjectReference Include="..\CircleAI.Audio\CircleAI.Audio.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <!-- Whisper ASR. Whisper.net wraps whisper.cpp AND ships its native library
         per-RID via NuGet, closing the "no whisper.dll ships" gap by construction
         — the same way Microsoft.ML.OnnxRuntime ships ONNX natives. Whisper.net
         is de-Googled (whisper.cpp, MIT) and loads the ggml-tiny model the
         registry already catalogues. Proven via tools/stt-hear (JFK sample
         transcribed verbatim on Windows, 2026-07-21). Whisper.net.Runtime is the
         desktop/server native package; Android/iOS heads add the matching
         Whisper.net.Runtime.<rid> package, mirroring the MNN native-lib story. -->
    <PackageReference Include="Whisper.net" Version="1.8.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.8.1" />
    <!-- NOTE: sherpa-onnx is deliberately NOT referenced here. Its native
         statically links GPLv3 espeak-ng, which would taint this shipped,
         permissive-licensed library. The multi-engine (Piper/mimic3/coqui/Kokoro/
         Matcha) runtime runs OUT-OF-PROCESS behind the GPL wall — see the
         com.bhengubv.espeakng pattern — and CircleAI reaches it by IPC. The
         SherpaOnnxTtsEngine proof lives in the non-distributed tools/tts-speak. -->
  </ItemGroup>
</Project>
