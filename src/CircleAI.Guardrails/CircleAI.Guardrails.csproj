<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Guardrails</PackageId>
    <Version>2.7.0</Version>
    <Description>(2.6.0) Safety-guardrails contracts — pattern-adoption of Sponsio. Separate from the personal-safety domain pack `CircleAI.Safety`. IContentFilter (pre-completion guardrails) + IRefusalPolicy + IPromptInjectionDetector (second-order attacks via RAG/web/tool output) + ISafetyAuditLog. Null impls fail-closed (treat everything as refused, log nothing). Real backends in 2.6.1.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;guardrails;refusal;safety;sponsio</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
