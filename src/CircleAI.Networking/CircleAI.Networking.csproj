<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Networking</PackageId>
    <Description>
      Transport-agnostic networking abstractions for Circle AI.
      INetworkTransport / ISyncChannel work across HTTP, WebSocket, gRPC, MQTT,
      TCP, WiFi Direct, BLE GATT, NearLink, Aether mesh, and DTN bundles.
      Specific transports live in CircleAI.Networking.* sub-packages.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- DeviceTier, carried on every MeshCapabilityAdvertisement. CircleAI.Core
         has no project references, so this edge cannot cycle. -->
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
