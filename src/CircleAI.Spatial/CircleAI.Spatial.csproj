<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Spatial</PackageId>
    <Version>2.6.0</Version>
    <Description>(2.5.0) Spatial / geo contract surface — let an AI talk about places. IGeoTileSource (deck.gl + cesium), IRadarReadout (RADAR), I3DSceneRenderer (flame + anime), ISkyTracker (skylight) — null implementations ship; real backends land in 2.5.1 when the underlying JS / native libs are bridged.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;spatial;geo;maps;radar;sky;3d</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
