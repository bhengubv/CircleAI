<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Inference.Server</PackageId>
    <Description>OpenAI-compatible hosted inference server over CircleAI.Hosting.InferenceBridge. 2.0.2 picks up CircleAI.Skills 2.0.2 — skill-pack auto-import on host start. Server API surface unchanged. Endpoints: /v1/chat/completions (SSE streaming), /v1/embeddings, /v1/companion/*, /v1/diagnostics, /v1/healthz, /v1/readyz.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <UserSecretsId>circleai-inference-server-9d0e4c45</UserSecretsId>
    <RootNamespace>CircleAI.Inference.Server</RootNamespace>
    <AssemblyName>CircleAI.Inference.Server</AssemblyName>
    <!-- NOT A PACKAGE. It was one so that downstream hosts could build their own
         Program.cs on InferenceServerBuilder - but the builder, the endpoints and
         the default ICompanionSessionResolver / IBridgeFactory wiring all moved
         into the library (src/CircleAI/InferenceServer), so the CircleAI package
         carries them and this one would carry only the Program.cs below. Circle AI
         ships as ONE package; this project is the app that hosts it. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Companion + bridge + embeddings — the three surfaces the server exposes. -->
    <!-- The PACKAGE, not the project. This is how CircleAI is consumed
         everywhere else, so the Windows service consumes it the same way: it
         builds against exactly what a customer restores, and a package that
         does not restore cannot be hidden by a working local tree. CircleAI
         3.8.0 did not restore on Android and a project reference here would
         never have said so. -->
    <!-- The project, not the package. They are the same C# - the package is a
         snapshot of it - and this head's own 27 files moved INTO the library, so a
         snapshot taken before that move cannot contain them. Source is the truth;
         the package is what customers restore. -->
    <ProjectReference Include="..\CircleAI\CircleAI.csproj" />
    <!-- Skills + capability catalogue, for the /v1/capabilities and /v1/skills endpoints. -->
  </ItemGroup>

  <!-- JWT bearer, Windows-service and systemd hosting come from CircleAI now: the
       server's code moved there (InferenceServerHost), and its packages with it. -->

  <!-- appsettings.json + appsettings.Development.json are auto-included by
       the Web SDK as Content items; no explicit <Content> needed. -->

  <ItemGroup>
    <None Include="Dockerfile;systemd\circleai-inference-server.service;windows\install-windows-service.ps1" />
  </ItemGroup>

</Project>
