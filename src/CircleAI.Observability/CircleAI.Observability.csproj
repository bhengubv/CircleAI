<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>CircleAI.Observability</PackageId>
    <Version>2.7.0</Version>
    <Description>(2.7.0) Observability contracts — OTel traces, Prometheus metrics, Grafana dashboards, claude-team-dashboard. IMetricSink + ITraceSink + IDashboardPublisher. Null impls drop all signals (safe default). Real backends in 2.7.1.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;observability;otel;prometheus;grafana</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
