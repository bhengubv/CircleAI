<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Security</PackageId>
    <Version>1.2.0</Version><Description>
      Transport-agnostic AI Security Layer for Circle AI.
      Trust scoring, threat detection, and security directives work across
      any network transport (WiFi, BLE, NearLink, HTTP, Aether mesh, etc.).
      For AetherNet-specific telemetry integration, add CircleAI.Security.AetherNet.
    </Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- No transport dependencies — security primitives are self-contained. -->

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>

</Project>
