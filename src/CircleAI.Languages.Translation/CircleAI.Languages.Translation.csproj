<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.Languages.Translation</PackageId>
    <Description>On-device real-time translation for Circle AI. No API call, no data leaving device. Context-aware, live conversation mode, document translation.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Languages\CircleAI.Languages.csproj" />
    <ProjectReference Include="..\CircleAI.Inference\CircleAI.Inference.csproj" />
  </ItemGroup>
</Project>
