<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Skills</PackageId>
    <Version>2.0.1</Version><Description>Skill dispatch and execution pipeline for Circle AI on-device agents — 2.0.1 adds SkillPackLoader, a Claude Code-format SKILL.md parser + importer over ISkillStore. Compatible with bhengubv/Claude-BugHunter (51 hunting skills) and bhengubv/awesome-agent-skills (1000+ community skills). Lazy IAsyncEnumerable LoadAsync + ImportAsync over any ISkillStore. SkillPackManifest tracks name/version/source/license/count. Version aligned with 2.0.1 SDK bundle.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
