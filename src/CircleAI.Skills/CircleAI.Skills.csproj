<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Skills</PackageId>
    <Version>3.2.0</Version><Description>Skill dispatch and execution pipeline for Circle AI on-device agents — 2.0.2 adds skill-pack auto-import. SkillPackSource declares a remote pack (RepoUrl/GitRef/License/SkillSubdir); KnownSkillPacks ships 8 defaults (awesome-agent-skills, Anthropic-Cybersecurity-Skills, Privacy-Data-Protection-Skills, Claude-BugHunter, last30days-skill, eduba-brand, career-ops, build-your-own-x). HttpPackDownloader fetches GitHub tarballs under %LOCALAPPDATA%/CircleAI/skill-packs/; SkillPackAutoImporter orchestrates download + import with per-pack error isolation. Carries forward 2.0.1's SkillPackLoader. Version aligned with 2.0.2 SDK bundle.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <!--
      SqliteSkillStore. The same package CircleAI.Memory already ships to every
      Android head, at the same version - so on a phone this adds no native
      payload that is not already in the APK.

      It does NOT reach the browser: the WASM client references only
      CircleAI.Samples.Shared -> CircleAI.Assistant, which has zero project
      references by design and stays that way.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <!--
    The capability manifest, embedded so CapabilityManifestSkillStore can read it
    ON DEVICE — a file at the repo root is not present on a phone.

    LogicalName is pinned because the source lives outside this project
    directory; without it the generated resource name would not be predictable.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\capabilities.json"
                      LogicalName="CircleAI.Skills.capabilities.json" />
  </ItemGroup>
</Project>
