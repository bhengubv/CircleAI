<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Skills</PackageId>
    <Version>2.0.2</Version><Description>Skill dispatch and execution pipeline for Circle AI on-device agents — 2.0.2 adds skill-pack auto-import. SkillPackSource declares a remote pack (RepoUrl/GitRef/License/SkillSubdir); KnownSkillPacks ships 8 defaults (awesome-agent-skills, Anthropic-Cybersecurity-Skills, Privacy-Data-Protection-Skills, Claude-BugHunter, last30days-skill, eduba-brand, career-ops, build-your-own-x). HttpPackDownloader fetches GitHub tarballs under %LOCALAPPDATA%/CircleAI/skill-packs/; SkillPackAutoImporter orchestrates download + import with per-pack error isolation. Carries forward 2.0.1's SkillPackLoader. Version aligned with 2.0.2 SDK bundle.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
  </ItemGroup>
</Project>
