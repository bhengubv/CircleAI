<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CircleAI.IoT</PackageId>
    <Version>1.2.0</Version>
    <Description>Circle AI surface adapter for embedded IoT devices.
Voice-in, voice-out, minimal compute. Optimised for devices with
256 MB RAM or less running .NET IoT.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Companion\CircleAI.Companion.csproj" />
    <ProjectReference Include="..\CircleAI.Voice\CircleAI.Voice.csproj" />
  </ItemGroup>
</Project>
