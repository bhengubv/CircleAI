  <ItemGroup>
    <ProjectReference Include="..\Circle.AI.Core\Circle.AI.Core.csproj" />
    <ProjectReference Include="..\Circle.AI.Security\Circle.AI.Security.csproj" />
  </ItemGroup>

</Project>
