<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Telephony.Twilio</PackageId>
    <Version>3.3.0</Version>
    <Description>(3.3.0) Twilio carrier adapter for CircleAI.Telephony. Number provisioning + inbound webhook configuration + outbound dial + call termination via Twilio's REST API. Media-stream WebSocket plumbing is host-supplied via IMediaStream — the ASP.NET host (CircleAI.Hosting.Telephony.Twilio) wires the WebSocket to the carrier package's session abstraction. Fail-soft when AccountSid / AuthToken missing.</Description>
    <Authors>The Geek Network</Authors>
    <PackageTags>ai;circle-ai;telephony;voice;phone;carrier;twilio</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
    <ProjectReference Include="..\CircleAI.Telephony\CircleAI.Telephony.csproj" />
  </ItemGroup>

</Project>
