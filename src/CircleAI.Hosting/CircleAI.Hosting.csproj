<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== NUGET IDENTITY ========== -->
  <PropertyGroup>
    <PackageId>CircleAI.Hosting</PackageId>
    <Version>2.0.0</Version><Description>DI wiring + proactive reasoning host for Circle AI — 2.0.0 ships RT-04 brownout and the RT-08 fallback chain. IMemoryPressureSource (Normal/Trim/Critical) + IAIObserver.OnBrownoutAsync + AIService.BrownoutAsync(reason) hot-swap the running generator down the chain (e.g. Qwen3-8B → Qwen3-4B → Qwen3-1.7B → Qwen3-0.6B) when Android onTrimMemory critical fires. Generations drain gracefully before the swap. Carries forward 1.5.0's upgrade-detection plumbing and 1.4.0's device-inferred defaults.</Description>
  </PropertyGroup>

  <PropertyGroup>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CircleAI.Core\CircleAI.Core.csproj" />
		<ProjectReference Include="..\CircleAI.Inference\CircleAI.Inference.csproj" />
		<ProjectReference Include="..\CircleAI.Tools\CircleAI.Tools.csproj" />
		<ProjectReference Include="..\CircleAI.Memory\CircleAI.Memory.csproj" />
		<ProjectReference Include="..\CircleAI.Skills\CircleAI.Skills.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Logging abstractions only — no concrete logger forced on consumers.
		     Microsoft.Extensions.Logging.Abstractions is MIT-licensed and pure
		     managed code; safe under the sanctions / sovereign-stack policy. -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
		<!-- Hosting abstractions required by BackgroundInferenceWorker (IHostedService). -->
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<EnableRuntimeIdentifierChecking>false</EnableRuntimeIdentifierChecking>
		<PublishReadyToRun>false</PublishReadyToRun>
		<StripSymbols>true</StripSymbols>
	</PropertyGroup>
</Project>
