{
  "description": "CronScheduleParser.GetNextOccurrence: next UTC occurrence strictly after `after`. Field order min hour dom month dow (0=Sunday). after/expected are RFC3339 UTC.",
  "cases": [
    {
      "id": "every-minute",
      "cron": "* * * * *",
      "after": "2026-07-08T10:30:15Z",
      "expected": "2026-07-08T10:31:00Z"
    },
    {
      "id": "top-of-next-hour",
      "cron": "0 * * * *",
      "after": "2026-07-08T10:30:00Z",
      "expected": "2026-07-08T11:00:00Z"
    },
    {
      "id": "daily-at-0900",
      "cron": "0 9 * * *",
      "after": "2026-07-08T10:30:00Z",
      "expected": "2026-07-09T09:00:00Z"
    },
    {
      "id": "daily-at-0900-before",
      "cron": "0 9 * * *",
      "after": "2026-07-08T08:30:00Z",
      "expected": "2026-07-08T09:00:00Z"
    },
    {
      "id": "step-every-15-min",
      "cron": "*/15 * * * *",
      "after": "2026-07-08T10:07:00Z",
      "expected": "2026-07-08T10:15:00Z"
    },
    {
      "id": "list-of-minutes",
      "cron": "0,30 * * * *",
      "after": "2026-07-08T10:10:00Z",
      "expected": "2026-07-08T10:30:00Z"
    },
    {
      "id": "range-hours",
      "cron": "0 9-17 * * *",
      "after": "2026-07-08T20:00:00Z",
      "expected": "2026-07-09T09:00:00Z"
    },
    {
      "id": "range-with-step-hours",
      "cron": "0 0-12/6 * * *",
      "after": "2026-07-08T01:00:00Z",
      "expected": "2026-07-08T06:00:00Z"
    },
    {
      "id": "specific-dom",
      "cron": "0 0 15 * *",
      "after": "2026-07-08T00:00:00Z",
      "expected": "2026-07-15T00:00:00Z"
    },
    {
      "id": "specific-month-rolls-year",
      "cron": "0 0 1 1 *",
      "after": "2026-07-08T00:00:00Z",
      "expected": "2027-01-01T00:00:00Z"
    },
    {
      "id": "sunday-only",
      "cron": "0 0 * * 0",
      "after": "2026-07-08T00:00:00Z",
      "expected": "2026-07-12T00:00:00Z"
    },
    {
      "id": "strictly-after-exact-match",
      "cron": "30 10 * * *",
      "after": "2026-07-08T10:30:00Z",
      "expected": "2026-07-09T10:30:00Z"
    }
  ],
  "errorCases": [
    { "id": "too-few-fields", "cron": "* * * *" },
    { "id": "too-many-fields", "cron": "* * * * * *" },
    { "id": "minute-out-of-range", "cron": "60 * * * *" },
    { "id": "impossible-feb-31", "cron": "0 9 31 2 *" },
    { "id": "empty", "cron": "   " },
    { "id": "bad-step", "cron": "*/0 * * * *" }
  ]
}
