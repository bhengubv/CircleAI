<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Local AetherNet 2.x feed: the sibling aether-protocol repo's `dotnet pack`
         output. Lets CircleAI.AetherNet float AetherNet.* 2.* off the freshly-packed
         artifact; nuget.org stays as upstream fallback. -->
    <add key="aethernet-local" value="..\aether-protocol\artifacts\packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
