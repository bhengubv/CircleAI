    <!--
      LINKED, NOT REFERENCED. The sample's contracts are net10.0 only and this
      project builds a net9.0 leg as well, so a ProjectReference is refused
      outright. Compiling the source in is the honest alternative to
      multi-targeting a sample for a test's convenience - and unlike a copied
      file it cannot drift, because it IS the file the app ships.
    -->
    <Compile Include="..\..\samples\CircleAI.Samples.It.Contracts\BuiltInWakePhrases.cs"
             Link="Contracts\BuiltInWakePhrases.cs" />
    <Compile Include="..\..\samples\CircleAI.Samples.It.Contracts\SampleLanguages.cs"
             Link="Contracts\SampleLanguages.cs" />
    <Compile Include="..\..\samples\CircleAI.Samples.It.Contracts\ISettings.cs"
             Link="Contracts\ISettings.cs" />
    <Compile Include="..\..\samples\CircleAI.Samples.It.Contracts\IWakePhrases.cs"
             Link="Contracts\IWakePhrases.cs" />
    <!--
      FirstRun decides what a fresh phone downloads and what the loading screen
      says it already has, and it had NO TESTS - while its own header said it was
      moved into the shared sample precisely so that it could have them. It cost a
      census reading "5 of 5 on this phone" over a handset carrying thirty-two
      voices. VoiceNames comes with it because FirstRun names two voices through it.
    -->
    <Compile Include="..\..\samples\CircleAI.Samples.It\FirstRun.cs"
             Link="Sample\FirstRun.cs" />
    <Compile Include="..\..\samples\CircleAI.Samples.It\VoiceNames.cs"
             Link="Sample\VoiceNames.cs" />
