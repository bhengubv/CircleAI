<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Multi-target. Every test runs on both legs — Aether bridges
         are now contracts-only (no external runtime tether) so there
         is no longer a net10-only test subset. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)bhengu.runsettings</RunSettingsFilePath>
    <!-- Tests deliberately exercise types gated as Experimental on the public surface. -->
    <NoWarn>$(NoWarn);CIRCLEAI_MEM_CAP_001;CIRCLEAI_DEVCAPS_001;CIRCLEAI_PEER_001;CIRCLEAI_FED_001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CircleAI\CircleAI.csproj" />
    <!-- CircleAI.Maui is its own project again (UseMaui in the shared library
         broke AOT for the headless service), so tests that touch it need it. -->
    <ProjectReference Include="..\..\src\CircleAI.Maui\CircleAI.Maui.csproj" />
    <!-- Circle32McpTests and Circle32MultiplayerTests: that code is ASP.NET Core
         and moved to the server head, which is the only thing that can host it. -->
    <ProjectReference Include="..\..\src\CircleAI.Inference.Server\CircleAI.Inference.Server.csproj" />
    <!--
      REFERENCED NOW, NOT COMPILED IN BY PATH.

      Seven files used to be listed here individually - BuiltInWakePhrases,
      SampleLanguages, ISettings, SpokenVocabulary, IWakePhrases, FirstRun and
      VoiceNames - and the comment that stood here gave the reason:

        "The sample's contracts are net10.0 only and this project builds a net9.0
         leg as well, so a ProjectReference is refused outright."

      That reason is gone. The three CircleAI.Assistant projects were among the
      fourteen libraries that were net10.0-only while CLAUDE.md claimed everything
      multi-targeted; they needed nothing from net10 and now build both legs.

      SO THE WORKAROUND OUTLIVED ITS CAUSE, and it had a cost the original comment
      did not see: a compile-by-path reaches only the files somebody REMEMBERED TO
      LIST. It cannot drift in content, but it drifts by OMISSION - the transcript
      store could not be tested at all until this changed, and every future type
      would have needed another two lines here before a test could see it.
    -->
  </ItemGroup>
</Project>
